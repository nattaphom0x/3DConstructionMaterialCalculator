window.runStructAnalysis=function(){
  const dl=parseFloat(document.getElementById('st-dl')?.value)||4.0;
  const ll=parseFloat(document.getElementById('st-ll')?.value)||2.0;
  const floors=parseInt(document.getElementById('st-floors')?.value)||1;
  const fc_user=parseFloat(document.getElementById('st-fc')?.value)||25;
  const Wu=(1.2*dl+1.6*ll)*floors; // LRFD factored load kN/m²

  const results=[];
  objects.filter(o=>o.visible&&!o.userData.isAirBlock).forEach(obj=>{
    const box=new THREE.Box3().setFromObject(obj),sz=new THREE.Vector3(); box.getSize(sz);
    const planArea=sz.x*sz.z; // m²

    // Material compressive strength
    const mat=DB[obj.userData.wallType]; let fc=fc_user;
    if(mat){if(mat.name.includes('Brick')||mat.name.includes('อิฐ'))fc=5;
      else if(mat.name.includes('Block'))fc=8;
      else if(mat.name.includes('Concrete')||mat.name.includes('คอนกรีต'))fc=fc_user;
      else if(mat.name.includes('Earth')||mat.name.includes('ดิน'))fc=1.5;}

    // Rebar bonus (simplified ACI 318 short column Pn=0.85f'c*Ag + fy*As)
    let Pn=0.85*fc*planArea*1000; // kN (fc in MPa, area in m²→×10⁶mm²)
    if(obj.userData.rebar){
      const p=obj.userData.rebar;
      const Ag=(p.w*p.h); // cm²
      const As=Math.PI*(p.dia/2)**2*p.count/100; // cm²
      const fy=400; // MPa SD40
      Pn=(0.85*fc_user*(Ag-As)*100+fy*As*100)*0.8/1000; // kN
    }

    // Bond group — distribute load evenly among bonded members
    let bondBonus=1, groupColor=null;
    bondGroups.forEach(g=>{
      if(g.members.includes(obj.uuid)){ bondBonus=g.members.length; groupColor=g.color; }
    });

    const Pu=Wu*planArea/bondBonus; // kN demanded
    const DCratio=Pu/Math.max(Pn,1);
    results.push({obj,planArea,Pn:Pn.toFixed(1),Pu:Pu.toFixed(1),DCratio,bondBonus,fc,groupColor});
  });

  // Heatmap coloring
  objects.filter(o=>!o.userData.isAirBlock).forEach(obj=>{
    const r=results.find(x=>x.obj===obj);
    if(!r){const m=DB[obj.userData.wallType];if(m)obj.material.color.set(m.color);return;}
    if(heatmapOn){
      const t=Math.min(r.DCratio,1); const col=new THREE.Color(); col.setHSL((1-t)*0.33,0.9,0.42);
      obj.material.color.copy(col); obj.material.vertexColors=false;
    } else if(!bondStressOn) {
      const m=DB[obj.userData.wallType]; if(m) obj.material.color.set(m.color);
    }
    // Bond group outline color
    if(r.groupColor&&outLine&&outLine.parent===scene&&obj===sel){
      outLine.material.color.set(r.groupColor);
    }
  });

  // Load flow arrows
  arrowGroup.clear();
  if(arrowsOn){
    results.forEach(r=>{
      const box=new THREE.Box3().setFromObject(r.obj),ct=new THREE.Vector3(); box.getCenter(ct);
      const len=Math.min(Math.max(r.DCratio*3,0.5),5);
      const col=new THREE.Color(); col.setHSL((1-Math.min(r.DCratio,1))*0.33,0.9,0.45);
      arrowGroup.add(new THREE.ArrowHelper(new THREE.Vector3(0,-1,0),new THREE.Vector3(ct.x,box.max.y+0.4,ct.z),len,col,len*.2,len*.12));
    });
  }

  // Result text
  const resEl=document.getElementById('struct-result'); if(!resEl) return;
  if(!results.length){resEl.innerHTML='<div style="color:var(--muted)">ไม่มีวัตถุ</div>';return;}
  const worst=results.reduce((a,b)=>a.DCratio>b.DCratio?a:b);
  const status=worst.DCratio<0.5?'🟢 ปลอดภัย':worst.DCratio<0.75?'🟡 ตรวจสอบ':worst.DCratio<1?'🟠 ระวัง!':'🔴 วิกฤต!';
  resEl.innerHTML=`<div style="background:rgba(34,197,94,.06);border:1px solid rgba(34,197,94,.25);border-radius:5px;padding:7px">
    <div style="font-weight:700;margin-bottom:3px">${status}</div>
    <div style="font-size:10px">Wu = ${Wu.toFixed(1)} kN/m² (1.2DL+1.6LL)</div>
    <div style="font-size:10px">Worst D/C: <strong>${(worst.DCratio*100).toFixed(1)}%</strong> (${worst.obj.userData.name})</div>
    <div style="font-size:10px">Bond Groups: ${bondGroups.length} | f'c: ${fc_user} MPa</div>
  </div>`;
  const barsEl=document.getElementById('load-bars'); if(!barsEl) return;
  barsEl.innerHTML=results.slice(0,8).map(r=>{
    const pct=Math.min(r.DCratio*100,100); const col=`hsl(${(1-Math.min(r.DCratio,1))*120},75%,42%)`;
    const bg=r.DCratio>1?'#ef444422':r.DCratio>0.6?'#eab30822':'#22c55e18';
    return `<div class="load-bar-wrap" style="background:${bg}">
      <div class="load-bar-label"><span>${r.obj.userData.name}${r.groupColor?` <span style="color:${r.groupColor}">●</span>`:''}</span><span style="font-family:var(--mono);color:${col}">${pct.toFixed(1)}%</span></div>
      <div class="load-bar" style="width:${pct}%;background:${col}"></div>
    </div>`;
  }).join('');
};

