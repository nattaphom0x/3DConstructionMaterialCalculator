function snapshotState(){
  history=history.slice(0,historyIdx+1);
  const snap=objects.map(obj=>{
    const box=new THREE.Box3().setFromObject(obj),sz=new THREE.Vector3(); box.getSize(sz);
    return{
      name:obj.userData.name,wallType:obj.userData.wallType,showBricks:obj.userData.showBricks,
      isAirBlock:obj.userData.isAirBlock||false,
      rebar:obj.userData.rebar?{...obj.userData.rebar}:null,
      airCuts:obj.userData.airCuts?JSON.parse(JSON.stringify(obj.userData.airCuts)):null,
      holeBoxes:obj.userData.holeBoxes?JSON.parse(JSON.stringify(obj.userData.holeBoxes)):null,
      drawPoints:obj.userData.drawPoints?JSON.parse(JSON.stringify(obj.userData.drawPoints)):null,
      position:obj.position.toArray(),rotation:obj.rotation.toArray(),scale:obj.scale.toArray(),
      dims:[sz.x,sz.y,sz.z]
    };
  });
  history.push({objects:snap,groups:JSON.parse(JSON.stringify(groups))});
  if(history.length>50)history.shift(); else historyIdx++;
  updateUndoBtns();
}

function restoreState(snap){
  const snapObjs=snap.objects||snap;
  if(snap.groups!==undefined)groups=JSON.parse(JSON.stringify(snap.groups));
  multiSel=[];

  // Full cleanup: split meshes, hole meshes, bricks, rebars, objects
  [...objects].forEach(o=>{
    clearBricks(o); clearRebar(o);
    clearHoleMeshes(o);
    if(o.userData.isAirBlock){ [...o.children].filter(c=>c.userData.isHoleMesh).forEach(c=>{o.remove(c);c.geometry?.dispose();}); }
    if(o.userData.splitMeshes){ o.userData.splitMeshes.forEach(m=>{scene.remove(m);m.geometry?.dispose();}); }
    scene.remove(o); o.geometry?.dispose();
  });
  objects=[];

  // Rebuild objects from snapshot
  snapObjs.forEach(item=>{
    let mesh;
    if(item.drawPoints){
      const shape=new THREE.Shape(),pts=item.drawPoints;
      shape.moveTo(pts[0].x,pts[0].y);pts.slice(1).forEach(p=>shape.lineTo(p.x,p.y));
      const geo=new THREE.ExtrudeGeometry(shape,{depth:item.dims[1],bevelEnabled:false});
      geo.rotateX(-Math.PI/2);
      mesh=new THREE.Mesh(geo,new THREE.MeshLambertMaterial());
      mesh.position.fromArray(item.position);mesh.rotation.fromArray(item.rotation);
    } else if(item.isAirBlock){
      const[w,h,d]=[item.dims[0],item.dims[1],item.dims[2]];
      const geo=new THREE.BoxGeometry(w,h,d);
      mesh=new THREE.Mesh(geo,new THREE.MeshBasicMaterial({color:0x3b82f6,transparent:true,opacity:0.22,depthWrite:false,side:THREE.DoubleSide}));
      mesh.add(new THREE.LineSegments(new THREE.EdgesGeometry(geo),new THREE.LineBasicMaterial({color:0x3b82f6})));
      mesh.renderOrder=2;
      mesh.position.fromArray(item.position);mesh.rotation.fromArray(item.rotation);
    } else {
      // Recreate geometry at correct world size (dims already in world units)
      const[w,h,d]=item.dims;
      mesh=new THREE.Mesh(new THREE.BoxGeometry(w,h,d),new THREE.MeshLambertMaterial());
      mesh.position.fromArray(item.position);mesh.rotation.fromArray(item.rotation);
      // No scale — geometry is sized correctly
    }
    mesh.userData={
      name:item.name,wallType:item.wallType,showBricks:item.showBricks,
      isAirBlock:item.isAirBlock||false,
      rebar:item.rebar||null,
      airCuts:item.airCuts||null,
      holeBoxes:item.holeBoxes||null,
      drawPoints:item.drawPoints||null,
      brickMesh:null,rebarGroup:null,
      holeMeshes:[],splitMeshes:[]
    };
    if(!item.isAirBlock&&DB[item.wallType])mesh.material.color.set(DB[item.wallType].color);
    mesh.castShadow=!item.isAirBlock;mesh.receiveShadow=!item.isAirBlock;
    scene.add(mesh);objects.push(mesh);
  });

  // Rebuild holes for walls that had cuts
  objects.forEach(wall=>{
    if(wall.userData.isAirBlock||!wall.userData.airCuts?.length) return;
    wall.userData.airCuts.forEach(cut=>{
      // Find matching air block by name (uuid changes on recreate)
      const ab=objects.find(o=>o.userData.isAirBlock&&o.userData.name===cut.name);
      if(!ab) return;
      const abBox=new THREE.Box3().setFromObject(ab);
      const wallBox=new THREE.Box3().setFromObject(wall);
      if(!wallBox.intersectsBox(abBox)) return;
      renderVisualHole(ab, wall, wallBox.clone().intersect(abBox));
    });
  });

  // Rebuild bricks (after holes are set)
  objects.forEach(mesh=>{
    if(mesh.userData.showBricks) updateBricks(mesh);
    if(mesh.userData.rebar&&rebar3DOn){mesh.userData.showRebar=true;buildRebar3D(mesh);}
  });

  selectObj(null);refreshList();
}
