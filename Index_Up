  const html=bomHTML(sel.userData.wallType,d,`📌 ${sel.userData.name}`);
  document.getElementById('bom-content').innerHTML=html||'<div style="color:var(--muted)">ไม่มีข้อมูล</div>';
  showPanel('p-calc','tb-calc');
};

window.calcAll=function(){
  calcMode='all';
  const summary={}; let totalObjs=0,totalArea=0,totalVol=0;
  for(const k of Object.keys(DB)) summary[k]={area:0,vol:0,units3d:0,unitsStd:0,layers:1};
  objects.forEach(obj=>{
    if(!obj.visible||obj.userData.isAirBlock) return; totalObjs++;
    const t=obj.userData.wallType; if(!summary[t]) summary[t]={area:0,vol:0,units3d:0,unitsStd:0,layers:1};
    const d=calcObjectData(obj);
    summary[t].area+=d.area; summary[t].vol+=d.vol; summary[t].units3d+=d.units3d; summary[t].unitsStd+=d.unitsStd; summary[t].layers=Math.max(summary[t].layers,d.layers);
    totalArea+=d.area; totalVol+=d.vol;
  });
  let html=`<div style="background:rgba(240,165,0,.08);border:1px solid rgba(240,165,0,.3);border-radius:5px;padding:7px;margin-bottom:8px;font-size:11px">
    <strong>📦 Summary</strong> — ${totalObjs} วัตถุ | ${totalArea.toFixed(2)} m² | ${totalVol.toFixed(3)} m³</div>`;
  for(const [k,d] of Object.entries(summary)) if(DB[k]) html+=bomHTML(k,d);
  if(!totalObjs) html='<div style="color:var(--muted)">ไม่มีวัตถุ</div>';
  document.getElementById('bom-content').innerHTML=html;
  showPanel('p-calc','tb-calc');
};

