        mesh.userData={name:item.name,wallType:item.wallType,showBricks:item.showBricks||false,isAirBlock:item.isAirBlock||false,
          rebar:item.rebar||null,airCuts:item.airCuts||null,drawPoints:item.drawPoints||null,brickMesh:null,rebarGroup:null};
        if(!item.isAirBlock&&DB[item.wallType])mesh.material.color.set(DB[item.wallType].color);
        mesh.castShadow=!item.isAirBlock;mesh.receiveShadow=!item.isAirBlock;
