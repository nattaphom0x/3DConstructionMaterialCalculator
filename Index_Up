<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="UTF-8">
<title>SMR Builder Pro v3 — Construction 3D</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&family=Sarabun:wght@300;400;600;700&display=swap');
:root{
  --bg:#0d0f13;--surface:#161a22;--panel:#1c2130;--border:#2a3044;
  --accent:#f0a500;--accent2:#3b82f6;--green:#22c55e;--red:#ef4444;
  --purple:#a855f7;--orange:#fb923c;--text:#e2e8f0;--muted:#64748b;
  --font:'Sarabun',sans-serif;--mono:'JetBrains Mono',monospace;
}
*{box-sizing:border-box;margin:0;padding:0}
body{background:var(--bg);color:var(--text);font-family:var(--font);overflow:hidden;user-select:none}

/* TASKBAR */
#taskbar{position:fixed;top:0;left:0;right:0;height:40px;z-index:200;
  background:var(--surface);border-bottom:1px solid var(--border);
  display:flex;align-items:center;padding:0 10px;gap:4px;
  box-shadow:0 2px 16px rgba(0,0,0,.5);overflow-x:auto}
.logo{font-family:var(--mono);font-size:12px;font-weight:700;color:var(--accent);
  margin-right:8px;letter-spacing:1px;white-space:nowrap;flex-shrink:0}
.tb-sep{width:1px;height:20px;background:var(--border);margin:0 3px;flex-shrink:0}
.tb-btn{background:transparent;border:1px solid transparent;color:var(--muted);
  padding:3px 8px;font-size:11px;font-family:var(--font);cursor:pointer;
  border-radius:4px;transition:.15s;white-space:nowrap;flex-shrink:0}
.tb-btn:hover{background:var(--panel);color:var(--text);border-color:var(--border)}
.tb-btn.on{background:var(--accent);color:#000;border-color:var(--accent);font-weight:700}
.tb-btn.save{background:var(--green);color:#000;border-color:var(--green);font-weight:700}
.tb-btn.load{background:var(--accent2);color:#fff;border-color:var(--accent2);font-weight:700}
.tb-btn:disabled{opacity:.35;cursor:not-allowed}
#tb-right{margin-left:auto;display:flex;align-items:center;gap:6px;flex-shrink:0}
#dpt-badge{font-size:10px;font-family:var(--mono);padding:2px 8px;
  background:rgba(34,197,94,.15);color:var(--green);border:1px solid rgba(34,197,94,.3);
  border-radius:99px;white-space:nowrap}

/* PANELS */
.panel{position:fixed;z-index:100;background:var(--panel);border:1px solid var(--border);
  border-radius:8px;box-shadow:0 8px 32px rgba(0,0,0,.6);display:flex;flex-direction:column;
  min-width:200px;min-height:80px;overflow:hidden}
.panel-head{padding:7px 10px;display:flex;justify-content:space-between;align-items:center;
  cursor:move;border-bottom:1px solid var(--border);flex-shrink:0;background:rgba(255,255,255,.03)}
.panel-title{font-size:11px;font-weight:700;color:var(--text);display:flex;align-items:center;gap:6px;letter-spacing:.5px}
.dot{width:8px;height:8px;border-radius:50%;display:inline-block}
.panel-btns{display:flex;gap:4px}
.ph-btn{width:16px;height:16px;border-radius:3px;border:none;cursor:pointer;font-size:9px;
  display:flex;align-items:center;justify-content:center;color:#fff}
.ph-min{background:#f59e0b}.ph-close{background:#ef4444}
.panel-body{padding:8px;overflow-y:auto;flex:1}

/* FORM ELEMENTS */
.sec{font-size:10px;font-weight:700;letter-spacing:1.5px;color:var(--muted);
  text-transform:uppercase;margin:10px 0 5px}
.sec:first-child{margin-top:0}
button.ui-btn{width:100%;padding:6px 10px;font-size:11px;font-family:var(--font);
  background:var(--surface);border:1px solid var(--border);color:var(--text);
  cursor:pointer;border-radius:5px;transition:.15s;margin-bottom:4px;text-align:left}
button.ui-btn:hover{background:var(--border);color:#fff}
button.ui-btn.active{background:var(--accent);color:#000;border-color:var(--accent);font-weight:700}
button.ui-btn.primary{background:var(--accent2);border-color:var(--accent2);color:#fff;font-weight:700}
button.ui-btn.success{background:var(--green);border-color:var(--green);color:#000;font-weight:700}
button.ui-btn.danger{background:var(--red);border-color:var(--red);color:#fff;font-weight:700}
button.ui-btn.purple{background:var(--purple);border-color:var(--purple);color:#fff;font-weight:700}
button.ui-btn.orange{background:var(--orange);border-color:var(--orange);color:#000;font-weight:700}
input[type=text],input[type=number],select{width:100%;padding:4px 7px;font-size:11px;
  font-family:var(--font);background:var(--surface);border:1px solid var(--border);
  color:var(--text);border-radius:4px;margin-bottom:5px;outline:none;transition:.15s}
input:focus,select:focus{border-color:var(--accent2)}
input[type=color]{width:100%;height:26px;padding:0;border:none;margin-bottom:5px;cursor:pointer;border-radius:4px}
label{font-size:10px;color:var(--muted);display:block;margin-bottom:2px}
.row3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:4px;margin-bottom:5px}
.row3 input{margin-bottom:0}
.row2g{display:grid;grid-template-columns:1fr 1fr;gap:5px}
.row2g>div label{margin-bottom:2px}
.toggle-row{display:flex;align-items:center;justify-content:space-between;
  background:var(--surface);border:1px solid var(--border);border-radius:5px;
  padding:5px 8px;margin-bottom:5px}
.toggle-row span{font-size:11px}
.toggle-row input[type=checkbox]{width:auto;margin:0;cursor:pointer;accent-color:var(--accent)}
hr.sep{border:none;border-top:1px solid var(--border);margin:7px 0}

/* PROPS BOX */
#props-box{display:none;background:rgba(59,130,246,.06);border:1px solid rgba(59,130,246,.25);
  border-radius:6px;padding:7px;margin-bottom:7px}
#props-box .props-title{font-size:10px;font-weight:700;color:var(--accent2);margin-bottom:5px}

/* OUTLINER */
#obj-list{list-style:none}
#obj-list li{padding:4px 5px;font-size:11px;cursor:pointer;border-radius:4px;
  display:flex;justify-content:space-between;align-items:center;
  border-bottom:1px solid var(--border);transition:.1s}
#obj-list li:hover{background:var(--surface)}
#obj-list li.sel{background:rgba(240,165,0,.15);color:var(--accent);border-color:rgba(240,165,0,.3)}
#obj-list li.air-sel{background:rgba(59,130,246,.15);color:var(--accent2);border-color:rgba(59,130,246,.3)}
.obj-name{flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.obj-icons{display:flex;gap:3px;flex-shrink:0}
.oi{cursor:pointer;opacity:.6;font-size:12px;padding:1px 3px;border-radius:2px}
.oi:hover{opacity:1;background:rgba(255,255,255,.1)}

/* DIM LABELS */
.dim-inp{width:46px;padding:2px 0;text-align:center;font-family:var(--mono);
  font-size:11px;font-weight:700;border-radius:3px;outline:none;pointer-events:auto;border:2px solid}
.dim-inp.dx{border-color:#f87171;color:#fca5a5;background:rgba(248,113,113,.15)}
.dim-inp.dy{border-color:#4ade80;color:#86efac;background:rgba(74,222,128,.15)}
.dim-inp.dz{border-color:#60a5fa;color:#93c5fd;background:rgba(96,165,250,.15)}
.dim-inp:focus{background:#fff;color:#000;border-color:var(--accent)!important}

/* FILTER */
.filter-wrap{display:flex;flex-wrap:wrap;gap:3px;margin-bottom:7px}
.fchip{font-size:10px;padding:2px 7px;border-radius:99px;cursor:pointer;
  background:var(--surface);border:1px solid var(--border);color:var(--muted);transition:.15s}
.fchip:hover{border-color:var(--muted);color:var(--text)}
.fchip.on{background:var(--accent);color:#000;border-color:var(--accent);font-weight:700}

/* PLANE BOX */
#plane-box{display:none;background:var(--surface);border:1px dashed var(--border);border-radius:5px;padding:7px;margin-bottom:5px}
.plane-grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:3px;margin-bottom:5px}

/* BOM */
.calc-block{background:var(--surface);border-radius:6px;padding:8px;margin-bottom:8px;border-left:3px solid var(--accent)}
.calc-block h3{font-size:12px;margin-bottom:3px}
.calc-block .sub{font-size:10px;color:var(--muted);margin-bottom:6px}
table.res{width:100%;border-collapse:collapse;font-size:11px}
table.res th{background:var(--panel);color:var(--accent);padding:4px 6px;text-align:left;font-size:10px;border:1px solid var(--border)}
table.res td{border:1px solid var(--border);padding:4px 6px}
table.res tr:nth-child(even) td{background:rgba(255,255,255,.02)}
.compare-box{background:rgba(59,130,246,.06);border:1px solid rgba(59,130,246,.25);border-radius:5px;padding:7px;margin:6px 0;font-size:11px}
.cx-title{font-size:10px;font-weight:700;color:var(--accent2);margin-bottom:4px}

/* AIR BLOCK */
.ab-item{display:flex;align-items:center;gap:5px;padding:4px 6px;
  background:rgba(59,130,246,.08);border:1px solid rgba(59,130,246,.3);
  border-radius:4px;margin-bottom:3px;font-size:11px;cursor:pointer}
.ab-item.on{background:rgba(59,130,246,.25);border-color:var(--accent2)}

/* REBAR */
.rb-stat{display:grid;grid-template-columns:1fr 1fr;gap:3px;margin-bottom:6px}
.rb-stat-cell{background:var(--surface);border-radius:4px;padding:4px 6px;font-size:11px}
.rb-val{font-family:var(--mono);color:var(--accent);font-weight:700;font-size:12px}

/* STRUCTURAL */
.stress-legend{display:flex;align-items:center;gap:6px;margin-bottom:5px;font-size:10px}
.stress-grad{flex:1;height:10px;border-radius:3px;background:linear-gradient(to right,#22c55e,#eab308,#ef4444);border:1px solid var(--border)}
.bond-item{display:flex;align-items:center;gap:5px;padding:4px 7px;
  background:var(--surface);border-radius:4px;margin-bottom:3px;font-size:11px}
.bond-dot{width:9px;height:9px;border-radius:50%;flex-shrink:0}
.load-bar-wrap{background:var(--surface);border-radius:4px;padding:4px 7px;margin-bottom:3px}
.load-bar-label{display:flex;justify-content:space-between;font-size:10px;margin-bottom:2px}
.load-bar{height:5px;border-radius:3px;transition:.4s}

/* STATUS BAR */
#statusbar{position:fixed;bottom:0;left:0;right:0;height:22px;z-index:200;
  background:var(--surface);border-top:1px solid var(--border);
  display:flex;align-items:center;padding:0 12px;gap:16px;font-size:10px;font-family:var(--mono)}
#statusbar span{color:var(--muted)}
#statusbar .hi{color:var(--accent)}

/* CONTEXT MENU */
#ctx-menu{position:fixed;z-index:500;background:var(--panel);border:1px solid var(--border);
  border-radius:6px;padding:4px;box-shadow:0 8px 24px rgba(0,0,0,.6);display:none;min-width:160px}
#ctx-menu div{padding:5px 10px;font-size:11px;cursor:pointer;border-radius:4px;display:flex;align-items:center;gap:7px}
#ctx-menu div:hover{background:var(--border)}
#ctx-menu hr{border:none;border-top:1px solid var(--border);margin:2px 0}

/* SCROLLBAR */
::-webkit-scrollbar{width:5px}
::-webkit-scrollbar-track{background:transparent}
::-webkit-scrollbar-thumb{background:var(--border);border-radius:99px}

/* GROUP STYLES */
.group-header{padding:3px 6px;font-size:10px;font-weight:700;letter-spacing:.5px;
  background:rgba(168,85,247,.12);border:1px solid rgba(168,85,247,.3);
  border-radius:4px;margin-bottom:1px;cursor:pointer;display:flex;align-items:center;gap:5px;color:var(--purple)}
.group-header:hover{background:rgba(168,85,247,.22)}
.group-children{padding-left:10px;border-left:2px solid rgba(168,85,247,.3);margin-bottom:3px}
#obj-list li.multi-sel{background:rgba(59,130,246,.18);border-color:rgba(59,130,246,.4);color:var(--accent2)}
.sel-hint{font-size:9px;color:var(--muted);padding:3px 5px;text-align:center}
</style>
</head>
<body>

<!-- TASKBAR -->
<div id="taskbar">
  <div class="logo">⬛ SMR PRO v3</div>
  <div class="tb-sep"></div>
  <button class="tb-btn on" id="tb-tools"  onclick="togglePanel('p-tools')">🛠 Tools</button>
  <button class="tb-btn on" id="tb-outline" onclick="togglePanel('p-outline')">📝 Outliner</button>
  <button class="tb-btn"   id="tb-calc"   onclick="togglePanel('p-calc')">📊 BOM</button>
  <button class="tb-btn"   id="tb-rebar"  onclick="togglePanel('p-rebar')">🔩 Rebar</button>
  <button class="tb-btn"   id="tb-struct" onclick="togglePanel('p-struct')">📐 Structural</button>
  <button class="tb-btn"   id="tb-mat"    onclick="togglePanel('p-mat')">🎨 Materials</button>
  <button class="tb-btn"   id="tb-export" onclick="togglePanel('p-export')">📤 Export</button>
  <div class="tb-sep"></div>
  <button class="tb-btn" id="tb-undo" onclick="undoAction()" title="Ctrl+Z" disabled>↩ Undo</button>
  <button class="tb-btn" id="tb-redo" onclick="redoAction()" title="Ctrl+Y" disabled>↪ Redo</button>
  <div class="tb-sep"></div>
  <button class="tb-btn save" onclick="saveProject()">💾 Save</button>
  <button class="tb-btn load" onclick="document.getElementById('fi').click()">📂 Load</button>
  <input type="file" id="fi" style="display:none" accept=".smr" onchange="loadProject(this)">
  <div id="tb-right"><span id="dpt-badge">✓ มทอ.101-64</span></div>
</div>

<div id="canvas-wrap" style="position:fixed;inset:40px 0 22px 0"></div>
<div id="toast" style="position:fixed;bottom:32px;left:50%;transform:translateX(-50%);
  background:rgba(240,165,0,.95);color:#000;font-size:11px;font-weight:700;
  padding:5px 16px;border-radius:99px;z-index:9999;font-family:var(--mono);
  pointer-events:none;opacity:0;transition:opacity .3s"></div>

<!-- CONTEXT MENU -->
<div id="ctx-menu">
  <div onclick="ctxDuplicate()">⧉ Duplicate (Ctrl+D)</div>
  <div onclick="ctxFocus()">🎯 Focus Camera (F)</div>
  <div onclick="ctxRename()">✎ Rename</div>
  <hr>
  <div onclick="ctxCalcSingle()">🔢 Calculate This</div>
  <div onclick="ctxToggleBrick()">🧱 Toggle Brick View (B)</div>
  <div onclick="ctxApplyRebarToCtx()">🔩 Apply Current Rebar</div>
  <hr id="ctx-cut-sep" style="display:none">
  <div id="ctx-cut-item" onclick="ctxCutWithSelected()" style="color:var(--accent2);display:none">✂️ Cut with Selected Air Block</div>
  <div id="ctx-cut-group-sep" style="display:none"><hr></div>
  <div id="ctx-cut-group-item" onclick="ctxCutBlockInGroup()" style="color:var(--accent2);display:none">✂️ Cut Block (same group)</div>
  <hr>
  <div onclick="ctxAddToBond()" style="color:var(--accent2)">🔗 Add to Bond Selection</div>
  <hr id="ctx-group-sep">
  <div onclick="ctxCreateGroupWithMultiSel()" style="color:var(--purple)">📁 Create Group (selected)</div>
  <div id="ctx-remove-from-group-item" onclick="ctxRemoveFromGroup()" style="color:var(--muted);display:none">📂 Remove from Group</div>
  <hr>
  <div onclick="ctxDelete()" style="color:var(--red)">🗑 Delete (Del)</div>
</div>

<!-- ===== TOOLS PANEL ===== -->
<div class="panel" id="p-tools" style="top:50px;left:12px;width:248px;height:620px">
  <div class="panel-head" id="p-tools-head">
    <div class="panel-title"><span class="dot" style="background:var(--accent)"></span>TOOLS</div>
    <div class="panel-btns">
      <button class="ph-btn ph-min" onclick="minPanel('p-tools')">_</button>
      <button class="ph-btn ph-close" onclick="closePanel('p-tools','tb-tools')">×</button>
    </div>
  </div>
  <div class="panel-body">
    <div class="sec">เพิ่มวัตถุ</div>
    <button class="ui-btn" onclick="addWall()">➕ Wall / Cube</button>
    <button class="ui-btn" id="btn-draw" onclick="toggleDrawMode()">✎ Blueprint Drawing</button>
    <div id="plane-box">
      <div style="font-size:10px;color:var(--muted);margin-bottom:4px">เลือกระนาบ:</div>
      <div class="plane-grid">
        <button class="ui-btn" id="pl-xz" onclick="setPlane('XZ')" style="font-size:10px;padding:3px">XZ พื้น</button>
        <button class="ui-btn" id="pl-xy" onclick="setPlane('XY')" style="font-size:10px;padding:3px">XY ผนัง</button>
        <button class="ui-btn" id="pl-yz" onclick="setPlane('YZ')" style="font-size:10px;padding:3px">YZ ข้าง</button>
      </div>
      <button class="ui-btn success" style="margin-top:4px" onclick="finishExtrude()">✅ Finish & Extrude</button>
      <button class="ui-btn danger" style="margin-top:0" onclick="toggleDrawMode(false)">✕ Cancel</button>
    </div>

    <!-- AIR BLOCK SECTION -->
    <hr class="sep">
    <div class="sec">Air Block (ช่องเปิด)</div>
    <div style="font-size:10px;color:var(--muted);margin-bottom:5px">สร้าง Air Block ซ้อนผนัง → กด Apply เพื่อตัด BOM</div>
    <button class="ui-btn" onclick="addAirBlock()" style="border-color:rgba(59,130,246,.5);color:var(--accent2)">🌬 Add Air Block</button>
    <div id="air-size" style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:4px;margin-bottom:5px">
      <div><label>W (m)</label><input type="number" id="air-w" value="0.9" step="0.1" min="0.1"></div>
      <div><label>H (m)</label><input type="number" id="air-h" value="2.0" step="0.1" min="0.1"></div>
      <div><label>D (m)</label><input type="number" id="air-d" value="0.5" step="0.05" min="0.05"></div>
    </div>
    <div id="air-list" style="max-height:90px;overflow-y:auto;margin-bottom:5px"></div>
    <button class="ui-btn success" onclick="applyAirCuts()">✅ Apply Cuts → Update BOM</button>

    <hr class="sep">
    <div class="sec">Transform</div>
    <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:3px;margin-bottom:5px">
      <button class="ui-btn" id="btn-move"  onclick="setMode('translate')">Move(T)</button>
      <button class="ui-btn" id="btn-rot"   onclick="setMode('rotate')">Rot(E)</button>
      <button class="ui-btn" id="btn-scale" onclick="setMode('scale')">Scale(R)</button>
    </div>

    <hr class="sep">
    <div class="sec">Selected Object</div>
    <div id="props-box">
      <div class="props-title">📌 <span id="props-name">—</span></div>
      <label>Material</label>
      <select id="prop-mat"></select>
      <label>Position X/Y/Z</label>
      <div class="row3"><input type="number" id="px" step="0.1"><input type="number" id="py" step="0.1"><input type="number" id="pz" step="0.1"></div>
      <label>Rotation° X/Y/Z</label>
      <div class="row3"><input type="number" id="rx" step="15"><input type="number" id="ry" step="15"><input type="number" id="rz" step="15"></div>
      <div class="toggle-row">
        <span>🧱 Brick View</span>
        <input type="checkbox" id="chk-brick">
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:3px;margin-top:3px">
        <button class="ui-btn" style="margin:0;font-size:10px" onclick="copyObj()">📋 Copy</button>
        <button class="ui-btn" style="margin:0;font-size:10px" onclick="pasteObj()">📌 Paste</button>
        <button class="ui-btn" style="margin:0;font-size:10px" onclick="ctxDuplicate()">⧉ Dup</button>
      </div>
      <button class="ui-btn purple" onclick="calcSingle()" style="margin-top:3px">🔢 Calc This</button>
    </div>

    <hr class="sep">
    <div class="sec">Options</div>
    <div class="toggle-row"><span>🔲 Grid Snap 0.5m</span><input type="checkbox" id="chk-snap" checked></div>
    <div class="toggle-row"><span>📐 Dimensions</span><input type="checkbox" id="chk-dim" checked></div>

    <hr class="sep">
    <div class="sec">Filter View</div>
    <div class="filter-wrap" id="filter-wrap"></div>
    <button class="ui-btn success" onclick="calcAll()">📊 Calculate BOM</button>
  </div>
</div>

<!-- ===== OUTLINER ===== -->
<div class="panel" id="p-outline" style="top:50px;right:12px;width:240px;height:460px">
  <div class="panel-head" id="p-outline-head">
    <div class="panel-title"><span class="dot" style="background:var(--accent2)"></span>OUTLINER</div>
    <div class="panel-btns">
      <button class="ph-btn ph-min" onclick="minPanel('p-outline')">_</button>
      <button class="ph-btn ph-close" onclick="closePanel('p-outline','tb-outline')">×</button>
    </div>
  </div>
  <div class="panel-body" style="padding:5px">
    <div style="display:flex;gap:4px;margin-bottom:4px">
      <input type="text" id="search-obj" placeholder="🔍 Search..." style="margin:0;flex:1" oninput="refreshList()">
      <span id="obj-count" style="font-size:10px;color:var(--muted);white-space:nowrap;align-self:center;padding:0 3px"></span>
    </div>
    <div style="display:flex;gap:3px;margin-bottom:4px;flex-wrap:wrap">
      <button class="ui-btn" style="margin:0;font-size:9px;padding:3px 6px;flex:1" onclick="selectAllObjects()" title="Shift+A">Shift+A All</button>
      <button class="ui-btn" style="margin:0;font-size:9px;padding:3px 6px;flex:1" onclick="deselectAll()" title="Esc">Esc Clear</button>
      <button class="ui-btn purple" style="margin:0;font-size:9px;padding:3px 6px;flex:1" onclick="createGroupFromMultiSel()" title="Group selected">📁 Group</button>
    </div>
    <div id="multi-hint" class="sel-hint">Ctrl/Shift+คลิกใน Outliner เพื่อเลือกหลายชิ้น</div>
    <ul id="obj-list"></ul>
  </div>
</div>

<!-- ===== BOM PANEL ===== -->
