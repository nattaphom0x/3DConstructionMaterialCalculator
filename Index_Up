function refreshList(){
  const ul=document.getElementById('obj-list'), q=document.getElementById('search-obj').value.toLowerCase();
  ul.innerHTML='';
  const filtered=objects.filter(o=>o.userData.name.toLowerCase().includes(q));
  document.getElementById('obj-count').textContent=`${filtered.length}/${objects.length}`;

  // Build group map
  const renderedInGroup=new Set();
  // Render groups first
  groups.forEach(grp=>{
    const grpObjs=grp.members.map(uid=>filtered.find(o=>o.uuid===uid)).filter(Boolean);
    if(!grpObjs.length)return;
    grpObjs.forEach(o=>renderedInGroup.add(o.uuid));
    // Group header
    const header=document.createElement('div'); header.className='group-header';
    header.innerHTML=`<span style="color:${grp.color}">📁</span><span style="flex:1">${grp.name}</span><span style="font-size:9px;color:var(--muted)">${grpObjs.length}x</span><span style="cursor:pointer;color:var(--red);font-size:10px;padding:0 4px" onclick="dissolveGroup(${grp.id})" title="Dissolve Group">✕</span>`;
    ul.appendChild(header);
    // Children
    const children=document.createElement('div'); children.className='group-children';
    grpObjs.forEach(obj=>children.appendChild(makeObjLi(obj, grp)));
    ul.appendChild(children);
  });

  // Render ungrouped
  filtered.forEach(obj=>{
    if(renderedInGroup.has(obj.uuid))return;
    ul.appendChild(makeObjLi(obj,null));
  });

  refreshAirList(); updateStatusBar();
  // Update multiSel hint
  const hint=document.getElementById('multi-hint');
  if(hint) hint.style.display=multiSel.length>0?'none':'block';
}

function makeObjLi(obj, grp){
  const li=document.createElement('li');
  const isMultiSel=multiSel.includes(obj);
  if(isMultiSel) li.classList.add('multi-sel');
  else if(obj===sel) li.classList.add(obj.userData.isAirBlock?'air-sel':'sel');
  if(obj.userData.isAirBlock) li.style.opacity=obj.visible?'1':'0.4';
  const matLabel=obj.userData.isAirBlock?'🌬Air':(DB[obj.userData.wallType]?.name.split(' ')[0]||'?');
  const grpDot=grp?`<span style="color:${grp.color};font-size:9px;margin-right:2px">●</span>`:'';
  const nameSpan=document.createElement('span'); nameSpan.className='obj-name';
  nameSpan.title=obj.userData.name;
  nameSpan.innerHTML=`${grpDot}${obj.userData.name}<span style="color:${obj.userData.isAirBlock?'var(--accent2)':'var(--muted)'};font-size:10px"> (${matLabel})</span>`;
  const icons=document.createElement('span'); icons.className='obj-icons';
  const mkBtn=(ico,title,color,fn)=>{const s=document.createElement('span');s.className='oi';s.title=title;s.textContent=ico;if(color)s.style.color=color;s.addEventListener('click',e=>{e.stopPropagation();fn();});return s;};
  icons.appendChild(mkBtn(obj.visible?'👁️':'🕶️','Toggle',null,()=>{
    obj.visible=!obj.visible;
    if(obj.userData.brickMesh) obj.userData.brickMesh.visible=obj.visible;
    // If this is an AirBlock, sync visibility of hole edges on all walls that cut with it
    if(obj.userData.isAirBlock){
      // toggle child edge outline lines
      obj.children.filter(c=>c.userData.isHoleMesh).forEach(c=>{ c.visible=obj.visible; });
      // toggle split meshes on walls cut by this ab
      objects.filter(w=>!w.userData.isAirBlock&&w.userData.airCuts?.some(c=>c.abId===obj.uuid))
        .forEach(wall=>{
          if(wall.userData.splitMeshes) wall.userData.splitMeshes.forEach(m=>{ m.visible=obj.visible; });
          if(!obj.visible){ wall.material.visible = !wall.userData.showBricks; }
          else { wall.material.visible = false; }
        });
    }
    if(!obj.visible&&sel===obj) selectObj(null);
    refreshList();
  }));
  icons.appendChild(mkBtn('✎','Rename',null,()=>{const n=prompt('ชื่อใหม่:',obj.userData.name);if(n?.trim()){obj.userData.name=n.trim();refreshList();};}));
  if(obj.userData.isAirBlock&&sel&&!sel.userData.isAirBlock){icons.appendChild(mkBtn('✂️','Cut this Air from wall',null,()=>{cutAirFromWall(obj,sel);refreshList();}));}
  if(!obj.userData.isAirBlock) icons.appendChild(mkBtn('🔢','Calc',null,()=>{selectObj(obj);calcSingle();}));
  icons.appendChild(mkBtn('❌','Delete','var(--red)',()=>deleteObj(obj)));
  li.appendChild(nameSpan); li.appendChild(icons);
  li.addEventListener('click',e=>{
    if(e.target.classList.contains('oi'))return;
    if(e.ctrlKey||e.metaKey){toggleMultiSel(obj);}
    else if(e.shiftKey){rangeSelectTo(obj);}
    else{multiSel=[];selectObj(obj);}
  });
  return li;
}

