function rangeSelectTo(obj){
  const list=objects.filter(o=>o.visible);
  const from=sel?list.indexOf(sel):-1, to=list.indexOf(obj);
  if(from<0){toggleMultiSel(obj);return;}
  const lo=Math.min(from,to), hi=Math.max(from,to);
