  } else { pb.style.display='none'; hideDimLabels(); }
  refreshList(); updateStatusBar();
}

// ════ DELETE ════
function deleteObj(obj, silent=false) {
  if(!obj) return;
  clearBricks(obj);
  clearRebar(obj);
  clearHoleMeshes(obj);
  if(obj.userData.splitMeshes){ obj.userData.splitMeshes.forEach(m=>{scene.remove(m);m.geometry?.dispose();}); }
  // If deleting an airblock, clean up edge children it owns
  if(obj.userData.isAirBlock){
    [...obj.children].filter(c=>c.userData.isHoleMesh).forEach(c=>{obj.remove(c);c.geometry?.dispose();});
  }
  scene.remove(obj); obj.geometry?.dispose();
  objects=objects.filter(o=>o!==obj);
  // Remove from groups
  groups=groups.map(g=>({...g,members:g.members.filter(uid=>uid!==obj.uuid)}));
  groups=groups.filter(g=>g.members.length>0);
  // Remove from multiSel
  multiSel=multiSel.filter(o=>o!==obj);
  if(sel===obj) selectObj(null);
  if(!silent){refreshList(); refreshAirList(); updateStatusBar();}
}
window.deleteObj=deleteObj;

// ════ SNAP ════
function snapObject(obj) {
  if(!obj||!snapEnabled) return;
  const s=0.5;
  obj.position.x=Math.round(obj.position.x/s)*s;
  obj.position.z=Math.round(obj.position.z/s)*s;
  obj.position.y=Math.max(0,Math.round(obj.position.y/s)*s);
}

// ════ RESIZE ════
function resizeAxis(obj,axis,val) {
  const box=new THREE.Box3().setFromObject(obj), sz=new THREE.Vector3(); box.getSize(sz);
  const cur=axis==='x'?sz.x:axis==='y'?sz.y:sz.z;
  if(cur>0) obj.scale[axis]*=val/cur;
  updateDimLabels(); clearBricks(obj); updateBricks(obj); updateRealtimeCalc();
}

