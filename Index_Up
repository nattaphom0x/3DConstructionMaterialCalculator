// Move all group members when primary sel moves
tCtrl.addEventListener('objectChange',()=>{
  if(!sel)return;
  const grp=getObjGroup(sel);
  if(!grp)return;
  const delta=sel.position.clone().sub(sel.userData._lastPos||sel.position);
  if(delta.lengthSq()<0.000001)return;
  grp.members.forEach(uid=>{
    const o=objects.find(o=>o.uuid===uid);
    if(!o||o===sel)return;
    o.position.add(delta);
  });
  sel.userData._lastPos=sel.position.clone();
});
