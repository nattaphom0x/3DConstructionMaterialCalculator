// Cut Block via Group: if AirBlock & Wall are in same group, cut the wall
window.ctxCutBlockInGroup=function(){
  if(!ctxObj)return;
  // Find the wall and the airblock within the same group
  const grp=getObjGroup(ctxObj);
  if(!grp)return toast('❌ วัตถุไม่อยู่ในกลุ่ม');
  const memberObjs=grp.members.map(uid=>objects.find(o=>o.uuid===uid)).filter(Boolean);
  const airBlocks=memberObjs.filter(o=>o.userData.isAirBlock);
  const walls=memberObjs.filter(o=>!o.userData.isAirBlock);
  if(!airBlocks.length)return toast('❌ ไม่พบ Air Block ในกลุ่มนี้');
  if(!walls.length)return toast('❌ ไม่พบ Wall ในกลุ่มนี้');
  let cutCount=0;
  airBlocks.forEach(ab=>{
    walls.forEach(wall=>{
      const abBox=new THREE.Box3().setFromObject(ab);
      const wallBox=new THREE.Box3().setFromObject(wall);
      if(!wallBox.intersectsBox(abBox))return;
      const inter=wallBox.clone().intersect(abBox);
      const sz=new THREE.Vector3(); inter.getSize(sz);
      const cutArea=Math.max(sz.x,sz.z)*sz.y;
      if(cutArea<0.001)return;
      if(!wall.userData.airCuts)wall.userData.airCuts=[];
      wall.userData.airCuts=wall.userData.airCuts.filter(c=>c.abId!==ab.uuid);
      wall.userData.airCuts.push({abId:ab.uuid,name:ab.userData.name,area:cutArea,w:Math.max(sz.x,sz.z),h:sz.y});
      // Remove old holes for this pair then re-render
      if(wall.userData.holeMeshes){ clearHoleMeshes(wall); }
      renderVisualHole(ab, wall, inter);
      cutCount++;
    });
  });
  refreshAirList(); refreshList();
  // Refresh bricks on affected walls
  walls.filter(w=>w.userData.showBricks).forEach(w=>{clearBricks(w);updateBricks(w);});
  snapshotState();
  toast(`✂️ ตัดแล้ว ${cutCount} cut(s) ในกลุ่ม "${grp.name}" — BOM อัปเดต`);
};

