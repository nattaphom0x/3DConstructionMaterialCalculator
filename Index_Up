function buildRebar3D(obj){
  clearRebar(obj);
  if(!obj.userData.rebar||!obj.userData.showRebar) return;
  const p=obj.userData.rebar;
  const box=new THREE.Box3().setFromObject(obj),sz=new THREE.Vector3(); box.getSize(sz);
  const H=sz.y, group=new THREE.Group();
  const barMat=new THREE.MeshLambertMaterial({color:0xfb923c});
  const stirMat=new THREE.MeshLambertMaterial({color:0xa855f7});
  const barR=(p.dia/2)/1000, stirR=(p.stirDia/2)/1000;
  const cover=p.cover/100, colW=p.w/100, colH=p.h/100;

  if(p.type==='col_round'){
    const radius=(Math.min(p.w,p.h)/2)/100-cover-p.stirDia/1000;
    for(let i=0;i<p.count;i++){
      const a=(i/p.count)*Math.PI*2;
      const m=new THREE.Mesh(new THREE.CylinderGeometry(barR,barR,H,6),barMat);
      m.position.set(radius*Math.cos(a),0,radius*Math.sin(a)); group.add(m);
    }
  } else {
    const c=cover+p.stirDia/1000+barR, W=colW, D=colH;
    const x0=c-W/2,x1=W/2-c,z0=c-D/2,z1=D/2-c;
    const corners=[[x0,z0],[x1,z0],[x1,z1],[x0,z1]]; let pts=[...corners];
    if(p.count>4){const ex=p.count-4,pS=Math.floor(ex/4),r2=ex-pS*4;
      [[x0,z0,x1,z0,pS+(r2>0?1:0)],[x1,z0,x1,z1,pS+(r2>1?1:0)],[x1,z1,x0,z1,pS+(r2>2?1:0)],[x0,z1,x0,z0,pS]].forEach(([ax,az,bx,bz,c2])=>{
        for(let i=1;i<=c2;i++){const t=i/(c2+1);pts.push([ax+t*(bx-ax),az+t*(bz-az)]);}})}
    pts.slice(0,p.count).forEach(([bx,bz])=>{const m=new THREE.Mesh(new THREE.CylinderGeometry(barR,barR,H,6),barMat);m.position.set(bx,0,bz);group.add(m);});
  }
  // Stirrups
  const stirSp=p.stirSp/100, sc=Math.ceil(H/stirSp)+1;
  const hw=colW/2-cover, hd=colH/2-cover;
  for(let i=0;i<=sc;i++){
    const y=-H/2+i*stirSp;
    const corners2=[[-hw,-hd],[hw,-hd],[hw,hd],[-hw,hd],[-hw,-hd]];
    for(let j=0;j<4;j++){
      const [ax,az]=corners2[j],[bx,bz]=corners2[j+1];
      const len=Math.sqrt((bx-ax)**2+(bz-az)**2);
      const m=new THREE.Mesh(new THREE.CylinderGeometry(stirR,stirR,len,5),stirMat);
      m.position.set((ax+bx)/2,y,(az+bz)/2);
      if(Math.abs(ax-bx)<0.001){m.rotation.x=Math.PI/2;}else{m.rotation.z=Math.PI/2;}
      group.add(m);
    }
  }
  obj.add(group); obj.userData.rebarGroup=group;
}

