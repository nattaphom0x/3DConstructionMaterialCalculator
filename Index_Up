window.addEventListener('keydown',e=>{
  if(['INPUT','SELECT','TEXTAREA'].includes(document.activeElement.tagName))return;
  if(e.ctrlKey||e.metaKey){
    if(e.key==='z'){e.preventDefault();undoAction();return;}
    if(e.key==='y'){e.preventDefault();redoAction();return;}
    if(e.key==='c'){e.preventDefault();copyObj();return;}
    if(e.key==='v'){e.preventDefault();pasteObj();return;}
    if(e.key==='d'){e.preventDefault();if(ctxObj||sel){ctxObj=ctxObj||sel;ctxDuplicate();}return;}
  }
  if(e.key==='Delete'||e.key==='Backspace'){
    if(multiSel.length>1){snapshotState();[...multiSel].forEach(o=>deleteObj(o,true));multiSel=[];refreshList();}
    else if(sel){snapshotState();deleteObj(sel);}
  }
  // Shift+A = select all
  if(e.shiftKey&&e.key.toLowerCase()==='a'){e.preventDefault();selectAllObjects();return;}
  if(e.key==='Escape'){
    if(drawMode)toggleDrawMode(false);
    else if(multiSel.length>0){multiSel=[];selectObj(null);}
    else selectObj(null);
  }
  if(e.key.toLowerCase()==='t')setMode('translate');
  if(e.key.toLowerCase()==='r')setMode('scale');
  if(e.key.toLowerCase()==='e')setMode('rotate');
  if(e.key.toLowerCase()==='g')addWall();
  if(e.key.toLowerCase()==='b'){if(sel&&!sel.userData.isAirBlock){sel.userData.showBricks=!sel.userData.showBricks;document.getElementById('chk-brick').checked=sel.userData.showBricks;clearBricks(sel);updateBricks(sel);}}
  if(e.key.toLowerCase()==='f'&&sel){const box=new THREE.Box3().setFromObject(sel),ct=new THREE.Vector3();box.getCenter(ct);orbit.target.copy(ct);}
  if(e.key.toLowerCase()==='m')setControlMode(controlMode==='hand'?'cursor':'hand');
  if(e.key.toLowerCase()==='c')setControlMode('cursor');
});

window.setMode=function(mode){
  tCtrl.setMode(mode);
  ['move','rot','scale'].forEach(m=>document.getElementById('btn-'+m).classList.remove('active'));
  const map={translate:'move',rotate:'rot',scale:'scale'}; document.getElementById('btn-'+map[mode])?.classList.add('active');
  document.getElementById('sb-mode').textContent=mode;
};

// ═══════════════════════════════════════════
// CLICK HANDLER
// ═══════════════════════════════════════════
renderer.domElement.addEventListener('click',e=>{
  if(e.button!==0||mmb.active)return;
  if(controlMode==='hand')return;
  mouse.x=(e.clientX/container.clientWidth)*2-1; mouse.y=-(e.clientY/container.clientHeight)*2+1;
  raycaster.setFromCamera(mouse,camera);
  if(drawMode){
    const hits=raycaster.intersectObject(rayPlane);
    if(hits.length){let pt=hits[0].point.clone();if(snapEnabled){pt.x=Math.round(pt.x*2)/2;pt.y=Math.round(pt.y*2)/2;pt.z=Math.round(pt.z*2)/2;}addDrawPt(pt);}
  } else {
    if(tCtrl.dragging)return;
    const hits=raycaster.intersectObjects(objects.filter(o=>o.visible));
    const hit=hits.length?hits[0].object:null;
    if(e.shiftKey&&hit){
      // Shift+click: range-select or add to multiSel
      rangeSelectTo(hit);
      // Also add to bond pending (existing behavior)
      if(!bondPending.includes(hit.uuid)){
        bondPending.push(hit.uuid);
        document.getElementById('bond-sel-count').textContent=bondPending.length;
        document.getElementById('sb-bond').textContent=bondPending.length;
      }
    } else if(e.ctrlKey&&hit){
      toggleMultiSel(hit);
    } else {
      multiSel=[]; selectObj(hit);
    }
  }
});

renderer.domElement.addEventListener('mousemove',e=>{
  mouse.x=(e.clientX/container.clientWidth)*2-1; mouse.y=-(e.clientY/container.clientHeight)*2+1;
  raycaster.setFromCamera(mouse,camera);
  const hits=raycaster.intersectObject(rayPlane);
  if(hits.length){const p=hits[0].point;document.getElementById('sb-coords').textContent=`X:${p.x.toFixed(2)} Y:${p.y.toFixed(2)} Z:${p.z.toFixed(2)}`;}
});

// ════ MIDDLE MOUSE BUTTON (MMB) ROTATION ════
let mmb={active:false,x:0,y:0};
renderer.domElement.addEventListener('mousedown',e=>{
  if(e.button===1){e.preventDefault();mmb.active=true;mmb.x=e.clientX;mmb.y=e.clientY;}
});
renderer.domElement.addEventListener('mousemove',e=>{
  if(mmb.active){
    const dx=(e.clientX-mmb.x)*0.01,dy=(e.clientY-mmb.y)*0.01;
    orbit.rotateLeft(dx);orbit.rotateUp(dy);
    mmb.x=e.clientX;mmb.y=e.clientY;
  }
});
renderer.domElement.addEventListener('mouseup',e=>{if(e.button===1)mmb.active=false;});
renderer.domElement.addEventListener('contextmenu',e=>e.preventDefault());

window.addEventListener('resize',()=>{
  const w=container.clientWidth,h=container.clientHeight;
  camera.aspect=w/h;camera.updateProjectionMatrix();renderer.setSize(w,h);labelRen.setSize(w,h);
});

// ═══════════════════════════════════════════
// STATUS BAR
// ═══════════════════════════════════════════
function updateStatusBar(){
  document.getElementById('sb-objs').textContent=objects.length;
  document.getElementById('sb-sel').textContent=sel?sel.userData.name:'—';
}

// ═══════════════════════════════════════════
// ANIMATE
// ═══════════════════════════════════════════
function animate(){
  requestAnimationFrame(animate); orbit.update();
  if(sel && outLine){
    // Recompute outline each frame to track position/rotation/scale changes
    const box = new THREE.Box3().setFromObject(sel);
    const sz = new THREE.Vector3(); box.getSize(sz);
    const center = new THREE.Vector3(); box.getCenter(center);
    outLine.position.copy(center);
    outLine.quaternion.copy(sel.quaternion);
    // Update geometry if size changed
    const og = outLine.geometry;
    const ps = og.parameters;
    if(ps && (Math.abs(ps.width-sz.x)>0.001||Math.abs(ps.height-sz.y)>0.001||Math.abs(ps.depth-sz.z)>0.001)){
      og.dispose();
      outLine.geometry = new THREE.EdgesGeometry(new THREE.BoxGeometry(sz.x,sz.y,sz.z));
    }
  }
  renderer.render(scene,camera); labelRen.render(scene,camera);
}

// ═══════════════════════════════════════════
// INIT
// ═══════════════════════════════════════════
populateUI(); setMode('translate'); rbPreview(); snapshotState(); animate();
</script>
