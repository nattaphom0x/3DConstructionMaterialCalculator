const GROUP_COLORS=['#a855f7','#f0a500','#22c55e','#3b82f6','#ef4444','#06b6d4'];
function getObjGroup(obj){return groups.find(g=>g.members.includes(obj.uuid));}
window.createGroupFromMultiSel=function(){
  const targets=multiSel.length>1?multiSel:(sel?[sel]:[]);
  if(targets.length<2)return toast('⚠️ เลือกอย่างน้อย 2 ชิ้นก่อน (Ctrl/Shift+คลิก)');
  const name=prompt('ชื่อกลุ่ม:',`Group ${groups.length+1}`); if(!name?.trim()) return;
  // Remove from old groups
  targets.forEach(o=>{groups=groups.map(g=>({...g,members:g.members.filter(uid=>uid!==o.uuid)}));});
  groups=groups.filter(g=>g.members.length>0);
  const color=GROUP_COLORS[groups.length%GROUP_COLORS.length];
  groups.push({id:Date.now(),name:name.trim(),color,members:targets.map(o=>o.uuid)});
  multiSel=[]; refreshList(); snapshotState();
  toast(`📁 กลุ่ม "${name.trim()}" สร้างแล้ว (${targets.length} ชิ้น)`);
};
