<script type="module">
import * as THREE from 'three';
import { OrbitControls }    from 'three/addons/controls/OrbitControls.js';
import { TransformControls } from 'three/addons/controls/TransformControls.js';
import { CSS2DRenderer, CSS2DObject } from 'three/addons/renderers/CSS2DRenderer.js';

// ═══════════════════════════════════════════
// MATERIAL DATABASE  (มทอ. 101-64)
// ═══════════════════════════════════════════
let DB = {
  brick:  { name:'Red Brick (อิฐมอญ)',        color:'#c0614e', calcType:'unit',   unitW:6.5,  unitH:4.0, unitL:14.0, gap:1.5, unitsPerSqm:117,  mortarPerSqm:0.15, sandPerSqm:0.04 },
  block:  { name:'Concrete Block (อิฐบล็อก)',color:'#8fa3a8', calcType:'unit',   unitW:7.0,  unitH:19.0,unitL:39.0, gap:1.0, unitsPerSqm:12.5, mortarPerSqm:0.12, sandPerSqm:0.03 },
  light:  { name:'Lightweight (มวลเบา)',      color:'#dde3e8', calcType:'unit',   unitW:7.5,  unitH:20.0,unitL:60.0, gap:0.3, unitsPerSqm:8.33, mortarPerSqm:0.10, sandPerSqm:0.0  },
  rammed: { name:'Rammed Earth (กำแพงดิน)',  color:'#7d5a42', calcType:'volume', unitW:0,    unitH:0,   unitL:0,    gap:0,   unitsPerSqm:0,    mortarPerSqm:0,    sandPerSqm:0.0  },
  conc:   { name:'Concrete (คอนกรีต)',        color:'#a0aabb', calcType:'volume', unitW:0,    unitH:0,   unitL:0,    gap:0,   unitsPerSqm:0,    mortarPerSqm:0,    sandPerSqm:0.0  },
};

// ═══════════════════════════════════════════
// THREE.JS SETUP
// ═══════════════════════════════════════════
const container = document.getElementById('canvas-wrap');
const renderer  = new THREE.WebGLRenderer({ antialias:true, stencil:true });
renderer.setPixelRatio(devicePixelRatio);
renderer.shadowMap.enabled = true;
renderer.shadowMap.type = THREE.PCFSoftShadowMap;
renderer.setSize(container.clientWidth, container.clientHeight);
container.appendChild(renderer.domElement);

const labelRen = new CSS2DRenderer();
labelRen.setSize(container.clientWidth, container.clientHeight);
labelRen.domElement.style.cssText='position:absolute;top:0;left:0;pointer-events:none;';
container.appendChild(labelRen.domElement);

const scene  = new THREE.Scene();
scene.background = new THREE.Color(0x0d0f13);
scene.fog = new THREE.Fog(0x0d0f13, 35, 80);

const camera = new THREE.PerspectiveCamera(50, container.clientWidth/container.clientHeight, 0.05, 500);
camera.position.set(8,7,10);

scene.add(new THREE.AmbientLight(0xffffff, 0.5));
const sun = new THREE.DirectionalLight(0xfff8e7, 1.2);
sun.position.set(8,16,10); sun.castShadow=true; sun.shadow.mapSize.set(2048,2048);
scene.add(sun);
const sunBack = new THREE.DirectionalLight(0x8ab4d4,0.3);
sunBack.position.set(-6,4,-8);
scene.add(sunBack);

let gridRef = new THREE.GridHelper(40,40,0x2a3044,0x1c2130);
scene.add(gridRef);
scene.add(new THREE.AxesHelper(1.5));
const arrowGroup = new THREE.Group(); scene.add(arrowGroup);

const orbit = new OrbitControls(camera, renderer.domElement);
orbit.enableDamping=true; orbit.dampingFactor=0.08;

const tCtrl = new TransformControls(camera, renderer.domElement);
tCtrl.setSize(1.6);
tCtrl.addEventListener('dragging-changed', e => {
  orbit.enabled = !e.value;
  if (!e.value) {
    // drag finished
    snapObject(sel);
    // Rebuild holes for any affected objects
    if (sel) rebuildHolesForObj(sel);
    if (sel?.userData.showBricks) { clearBricks(sel); updateBricks(sel); }
    updateRealtimeCalc();
    snapshotState();
  } else {
    if (sel?.userData.brickMesh) sel.userData.brickMesh.visible = false;
    if (sel?.userData.showBricks) sel.material.visible = true;
    // Hide split meshes while dragging so they don't lag behind
    if (sel) {
      if (sel.userData.splitMeshes) sel.userData.splitMeshes.forEach(m=>m.visible=false);
      // Also hide split meshes of walls affected by this air block
      if (sel.userData.isAirBlock) {
        objects.filter(w=>!w.userData.isAirBlock&&w.userData.airCuts?.some(c=>c.abId===sel.uuid))
          .forEach(w=>{ if(w.userData.splitMeshes) w.userData.splitMeshes.forEach(m=>m.visible=false); w.material.visible=true; });
      }
    }
  }
});
tCtrl.addEventListener('change', () => {
  if (!sel) return;
  if (snapEnabled && tCtrl.dragging) snapObject(sel);
  syncPropsUI(); updateDimLabels(); updateRealtimeCalc();
});
scene.add(tCtrl);

const rayPlane = new THREE.Mesh(new THREE.PlaneGeometry(200,200), new THREE.MeshBasicMaterial({visible:false,side:THREE.DoubleSide}));
rayPlane.rotation.x=-Math.PI/2; scene.add(rayPlane);

// Dim labels
const dimL = { x:mkDimLabel('dx'), y:mkDimLabel('dy'), z:mkDimLabel('dz') };
function mkDimLabel(cls) {
  const inp=document.createElement('input'); inp.type='number'; inp.step='0.05'; inp.className=`dim-inp ${cls}`;
  inp.addEventListener('change',()=>{ if(!sel)return; const v=parseFloat(inp.value); if(!isNaN(v)&&v>0.01) resizeAxis(sel,cls[1],v); });
  ['pointerdown','mousedown','keydown'].forEach(ev=>inp.addEventListener(ev,e=>e.stopPropagation()));
  const obj=new CSS2DObject(inp); obj.visible=false; scene.add(obj);
  return {dom:inp,obj};
}

// Outline selection — world-space safe
let outLine = null;
function setOutline(obj) {
  if (outLine) { scene.remove(outLine); outLine?.geometry?.dispose(); outLine=null; }
  if (!obj || obj.userData.isAirBlock) return;
  // Build edge geometry from a unit box scaled to world size
  const box = new THREE.Box3().setFromObject(obj);
  const sz = new THREE.Vector3(); box.getSize(sz);
  const geo = new THREE.BoxGeometry(sz.x, sz.y, sz.z);
  outLine = new THREE.LineSegments(
    new THREE.EdgesGeometry(geo),
    new THREE.LineBasicMaterial({color:0xf0a500, depthTest:false, linewidth:2})
  );
  outLine.renderOrder = 999;
  // Position at world center of object
  const center = new THREE.Vector3(); box.getCenter(center);
  outLine.position.copy(center);
  outLine.quaternion.copy(obj.quaternion);
  scene.add(outLine);
}

// ═══════════════════════════════════════════
// STATE
// ═══════════════════════════════════════════
let objects=[], sel=null, clipboard=null;
let multiSel=[];  // multi-selection array of objects
let groups=[];    // [{id, name, color, members:[uuid,...]}]
let drawMode=false, drawPts=[], drawMarkers=[], drawLine=null, drawPlane='XZ';
let snapEnabled=true, showDim=true;
let calcMode='none', lastCalcUUID=null;
let history=[], historyIdx=-1;
let bondGroups=[], bondPending=[], heatmapOn=false, arrowsOn=false;
let bondStressOn=false, rebar3DOn=false;
const safePos=new THREE.Vector3();
const raycaster=new THREE.Raycaster(), mouse=new THREE.Vector2();

// ═══════════════════════════════════════════
// TOAST
// ═══════════════════════════════════════════
function toast(msg, ms=2400) {
  const t=document.getElementById('toast');
  t.textContent=msg; t.style.opacity='1';
  clearTimeout(t._t); t._t=setTimeout(()=>t.style.opacity='0',ms);
}
window.showToast=toast;

// ═══════════════════════════════════════════
// POPULATE UI
// ═══════════════════════════════════════════
function populateUI() {
  const ps=document.getElementById('prop-mat'); ps.innerHTML='';
  const fw=document.getElementById('filter-wrap');
  fw.innerHTML='<span class="fchip on" onclick="filterView(\'all\',this)">All</span>';
  const ms=document.getElementById('mat-sel');
  ms.innerHTML='<option value="">— Select —</option>';
  for (const [k,m] of Object.entries(DB)) {
    const o1=document.createElement('option'); o1.value=k; o1.textContent=m.name; ps.appendChild(o1);
    const o2=document.createElement('option'); o2.value=k; o2.textContent=m.name; ms.appendChild(o2);
    const chip=document.createElement('span'); chip.className='fchip';
    chip.textContent=m.name.split(' ')[0]; chip.style.borderColor=m.color+'66'; chip.style.color=m.color;
    chip.onclick=function(){filterView(k,this);}; fw.appendChild(chip);
  }
}

// ═══════════════════════════════════════════
// OBJECT MANAGEMENT
// ═══════════════════════════════════════════
function addMesh(mesh,name='Wall',type='brick') {
  mesh.userData={name,wallType:type,showBricks:false,isAirBlock:false};
  if(DB[type]) mesh.material.color.set(DB[type].color);
  mesh.castShadow=true; mesh.receiveShadow=true;
  scene.add(mesh); objects.push(mesh);
  refreshList(); selectObj(mesh); snapshotState();
}

window.addWall=function(){
  const m=new THREE.Mesh(new THREE.BoxGeometry(2,2.5,0.15),new THREE.MeshLambertMaterial());
  m.position.y=1.25; addMesh(m,`Wall ${objects.length+1}`,'brick');
};

// ════ AIR BLOCKS ════
let airCount=0;
window.addAirBlock=function(){
  const w=parseFloat(document.getElementById('air-w').value)||0.9;
  const h=parseFloat(document.getElementById('air-h').value)||2.0;
  const d=parseFloat(document.getElementById('air-d').value)||0.5;
  airCount++;
  const geo=new THREE.BoxGeometry(w,h,d);
  const mat=new THREE.MeshBasicMaterial({color:0x3b82f6,transparent:true,opacity:0.22,depthWrite:false,side:THREE.DoubleSide});
  const mesh=new THREE.Mesh(geo,mat);
  mesh.position.y=h/2;
  mesh.renderOrder=2;
  const wf=new THREE.LineSegments(new THREE.EdgesGeometry(geo),new THREE.LineBasicMaterial({color:0x3b82f6,linewidth:2}));
  mesh.add(wf);
  const name=`AirBlock ${airCount}`;
  mesh.userData={name,isAirBlock:true,wallType:'_air',showBricks:false};
  scene.add(mesh); objects.push(mesh);
  refreshList(); selectObj(mesh); snapshotState();
  toast(`🌬 ${name} — ย้ายซ้อนผนัง แล้วกด Apply Cuts`);
};

window.applyAirCuts=function(){
  let count=0;
  // Clear all previous air cuts data
  objects.forEach(o=>{ if(!o.userData.isAirBlock) o.userData.airCuts=[]; });
  // Remove old hole visuals and reset stencil
  objects.forEach(o=>{
    clearHoleMeshes(o);
    if(o.userData.splitMeshes){ o.userData.splitMeshes.forEach(m=>{scene.remove(m);m.geometry?.dispose();}); o.userData.splitMeshes=[]; }
    if(!o.userData.isAirBlock) o.material.visible = !o.userData.showBricks;
  });

  objects.filter(ab=>ab.userData.isAirBlock&&ab.visible).forEach(ab=>{
    const abBox=new THREE.Box3().setFromObject(ab);
    objects.filter(w=>!w.userData.isAirBlock&&w.visible).forEach(wall=>{
      const wallBox=new THREE.Box3().setFromObject(wall);
      if(!wallBox.intersectsBox(abBox)) return;
      const inter=wallBox.clone().intersect(abBox);
      const sz=new THREE.Vector3(); inter.getSize(sz);
      const cutArea=Math.max(sz.x,sz.z)*sz.y;
      if(cutArea<0.001) return;
      if(!wall.userData.airCuts) wall.userData.airCuts=[];
      wall.userData.airCuts=wall.userData.airCuts.filter(c=>c.abId!==ab.uuid);
      wall.userData.airCuts.push({abId:ab.uuid,name:ab.userData.name,area:cutArea,w:Math.max(sz.x,sz.z),h:sz.y});
      count++;
      // ── Visual hole: dark "punch" mesh slightly inset in the wall ──
      renderVisualHole(ab, wall, inter);
    });
  });
  refreshAirList(); refreshList();
  // Refresh brick view on all walls that got cuts
  objects.filter(o=>!o.userData.isAirBlock&&o.userData.showBricks&&o.userData.airCuts?.length).forEach(w=>{clearBricks(w);updateBricks(w);});
  toast(`✅ Applied ${count} cut(s) — BOM อัปเดต`);
  snapshotState();
};

function renderVisualHole(ab, wall, interBox){
  if(!wall.userData.holeMeshes) wall.userData.holeMeshes=[];

  const sz=new THREE.Vector3(); interBox.getSize(sz);
  const ctr=new THREE.Vector3(); interBox.getCenter(ctr);

  // Wall thickness axis
  const wallBox=new THREE.Box3().setFromObject(wall);
  const wallSz=new THREE.Vector3(); wallBox.getSize(wallSz);

  // Hole box: full wall thickness on thin axis, air block size on wide axes
  let hGeoW, hGeoH, hGeoD;
  if(wallSz.x <= wallSz.z){ hGeoW = wallSz.x+0.06; hGeoH = sz.y+0.002; hGeoD = sz.z+0.002; }
  else                     { hGeoW = sz.x+0.002;    hGeoH = sz.y+0.002; hGeoD = wallSz.z+0.06; }

  const hMin = new THREE.Vector3(ctr.x-hGeoW/2, ctr.y-hGeoH/2, ctr.z-hGeoD/2);
  const hMax = new THREE.Vector3(ctr.x+hGeoW/2, ctr.y+hGeoH/2, ctr.z+hGeoD/2);

  applyClipHoleToWall(wall, hMin, hMax);

  // ── Edge outline: attach as CHILD of AirBlock so it moves with it ──
  // Remove old edge outline children from this ab that belong to this wall
  const oldEdges = ab.children.filter(c=>c.userData.holeEdgeForWall===wall.uuid);
  oldEdges.forEach(c=>{ ab.remove(c); c.geometry?.dispose(); });

  // Build outline in AirBlock local space
  const abBox = new THREE.Box3().setFromObject(ab);
  const abSz = new THREE.Vector3(); abBox.getSize(abSz);
  // Outline size matches the hole (wall-thickness wide, air-block sized height/width)
  const outlineGeo = new THREE.BoxGeometry(hGeoW, hGeoH, hGeoD);
  const edgeMat = new THREE.LineBasicMaterial({color:0x60a5fa, depthTest:true, transparent:true, opacity:0.8});
  const edgeLine = new THREE.LineSegments(new THREE.EdgesGeometry(outlineGeo), edgeMat);
  // Convert world center → AirBlock local space
  const localCtr = ab.worldToLocal(ctr.clone());
  edgeLine.position.copy(localCtr);
  edgeLine.renderOrder = 5;
  edgeLine.userData = { isHoleMesh: true, holeEdgeForWall: wall.uuid };
  ab.add(edgeLine);
  // Track it so we can remove on hole clear
  wall.userData.holeMeshes.push({ isAbChild: true, abRef: ab, child: edgeLine });

  // Store hole params for rebuild
  if(!wall.userData.holeBoxes) wall.userData.holeBoxes=[];
  wall.userData.holeBoxes = wall.userData.holeBoxes.filter(h=>h.abId!==ab.uuid);
  wall.userData.holeBoxes.push({abId:ab.uuid, min:hMin.toArray(), max:hMax.toArray()});
}

// Build a new wall geometry that has the hole region removed
function applyClipHoleToWall(wall, hMin, hMax){
  // Use clipping planes approach:
  // Show wall ONLY where it's OUTSIDE the hole box on at least one axis.
  // Three.js MeshBasicMaterial/MeshLambertMaterial supports clippingPlanes
  // but they hide everything on one side (AND logic = impossible to punch a hole).
  //
  // Solid approach: rebuild the InstancedMesh (bricks) skips bricks in hole (done).
  // For solid (non-brick) wall: use ColorWrite=false trick + depth trick.
  // Actually the cleanest approach: make the wall DoubleSide + transparent inside hole
  // using a custom shader – but that's complex.
  //
  // SIMPLEST that works: just hide the solid wall face and let brick instances do the work.
  // For non-brick walls, we split into sub-meshes (slabs above/below/left/right of hole).
  rebuildWallWithHoles(wall);
}

function rebuildWallWithHoles(wall){
  // Remove old split meshes
  if(wall.userData.splitMeshes){
    wall.userData.splitMeshes.forEach(m=>{scene.remove(m);m.geometry?.dispose();});
    wall.userData.splitMeshes=[];
  }
  if(!wall.userData.holeBoxes?.length) return;

  // For brick view, bricks already handle it — just hide the base mesh
  if(wall.userData.showBricks){ wall.material.visible=false; return; }

  // For solid walls: hide base mesh, spawn slab quads around the hole
  const wallBox = new THREE.Box3().setFromObject(wall);
  const wMin = new THREE.Vector3(), wMax = new THREE.Vector3();
  wallBox.getMin(wMin); wallBox.getMax(wMax);
  const wallSz = new THREE.Vector3(); wallBox.getSize(wallSz);

  // Use first hole only for now (multiple holes: iterate)
  const holeData = wall.userData.holeBoxes[0];
  const hMin = new THREE.Vector3().fromArray(holeData.min);
  const hMax = new THREE.Vector3().fromArray(holeData.max);

  // Determine thin axis
  const isThinX = wallSz.x <= wallSz.z;
  const wallColor = wall.material.color.clone();
  const slabMat = () => new THREE.MeshLambertMaterial({color:wallColor, side:THREE.DoubleSide});

  // Build 4 slabs: top, bottom, left, right of hole (in face plane)
  const slabs = [];
  if(isThinX){
    // Wall faces Z direction; hole cuts through X
    const cx = (wMin.x+wMax.x)/2, thick = wallSz.x;
    // Top slab: from hole top to wall top
    if(hMax.y < wMax.y - 0.001){
      const h = wMax.y - hMax.y;
      const g = new THREE.BoxGeometry(thick, h, wallSz.z);
      slabs.push({g, pos:new THREE.Vector3(cx, hMax.y+h/2, (wMin.z+wMax.z)/2)});
    }
    // Bottom slab
    if(hMin.y > wMin.y + 0.001){
      const h = hMin.y - wMin.y;
      const g = new THREE.BoxGeometry(thick, h, wallSz.z);
      slabs.push({g, pos:new THREE.Vector3(cx, wMin.y+h/2, (wMin.z+wMax.z)/2)});
    }
    // Left slab (negative Z)
    if(hMin.z > wMin.z + 0.001){
      const w2 = hMin.z - wMin.z;
      const g = new THREE.BoxGeometry(thick, hMax.y-hMin.y, w2);
      slabs.push({g, pos:new THREE.Vector3(cx, (hMin.y+hMax.y)/2, wMin.z+w2/2)});
    }
    // Right slab (positive Z)
    if(hMax.z < wMax.z - 0.001){
      const w2 = wMax.z - hMax.z;
      const g = new THREE.BoxGeometry(thick, hMax.y-hMin.y, w2);
      slabs.push({g, pos:new THREE.Vector3(cx, (hMin.y+hMax.y)/2, hMax.z+w2/2)});
    }
  } else {
    // Wall faces X direction
    const cz = (wMin.z+wMax.z)/2, thick = wallSz.z;
    if(hMax.y < wMax.y - 0.001){
      const h = wMax.y - hMax.y;
      const g = new THREE.BoxGeometry(wallSz.x, h, thick);
      slabs.push({g, pos:new THREE.Vector3((wMin.x+wMax.x)/2, hMax.y+h/2, cz)});
    }
    if(hMin.y > wMin.y + 0.001){
      const h = hMin.y - wMin.y;
      const g = new THREE.BoxGeometry(wallSz.x, h, thick);
      slabs.push({g, pos:new THREE.Vector3((wMin.x+wMax.x)/2, wMin.y+h/2, cz)});
    }
    if(hMin.x > wMin.x + 0.001){
      const w2 = hMin.x - wMin.x;
      const g = new THREE.BoxGeometry(w2, hMax.y-hMin.y, thick);
      slabs.push({g, pos:new THREE.Vector3(wMin.x+w2/2, (hMin.y+hMax.y)/2, cz)});
    }
    if(hMax.x < wMax.x - 0.001){
      const w2 = wMax.x - hMax.x;
      const g = new THREE.BoxGeometry(w2, hMax.y-hMin.y, thick);
      slabs.push({g, pos:new THREE.Vector3(hMax.x+w2/2, (hMin.y+hMax.y)/2, cz)});
    }
  }

  if(!wall.userData.splitMeshes) wall.userData.splitMeshes=[];
  slabs.forEach(s=>{
    const m = new THREE.Mesh(s.g, slabMat());
    m.position.copy(s.pos);
    m.castShadow=true; m.receiveShadow=true;
    m.userData={isSplitMesh:true};
    scene.add(m);
    wall.userData.splitMeshes.push(m);
  });

  // Hide original wall mesh (replaced by slabs)
  wall.material.visible = false;
}

// Helper to remove all hole mesh entries from wall
function clearHoleMeshes(wall){
  if(!wall.userData.holeMeshes) return;
  wall.userData.holeMeshes.forEach(h=>{
    if(h.isAbChild){ h.abRef.remove(h.child); h.child.geometry?.dispose(); }
    else { scene.remove(h); h.geometry?.dispose(); }
  });
  wall.userData.holeMeshes=[];
}

// Reset wall hole visuals (called when cuts are removed)
function clearWallStencil(wall){
  if(!wall||wall.userData.isAirBlock) return;
  clearHoleMeshes(wall);
  if(wall.userData.splitMeshes){
    wall.userData.splitMeshes.forEach(m=>{scene.remove(m);m.geometry?.dispose();});
    wall.userData.splitMeshes=[];
  }
  wall.userData.holeBoxes=[];
  if(!wall.userData.showBricks) wall.material.visible=true;
}

// Rebuild holes after an object is moved/rotated/scaled
function rebuildHolesForObj(obj){
  if(!obj) return;
  if(obj.userData.isAirBlock){
    // This air block may affect multiple walls — rebuild each
    objects.filter(w=>!w.userData.isAirBlock&&w.userData.airCuts?.some(c=>c.abId===obj.uuid))
      .forEach(wall=>rebuildWallHoles(wall));
  } else {
    // This is a wall — rebuild its own holes
    rebuildWallHoles(obj);
  }
}

// Full rebuild of hole visuals for one wall using its current airCuts
function rebuildWallHoles(wall){
  if(!wall||wall.userData.isAirBlock) return;
  clearHoleMeshes(wall);
  if(wall.userData.splitMeshes){ wall.userData.splitMeshes.forEach(m=>{scene.remove(m);m.geometry?.dispose();}); wall.userData.splitMeshes=[]; }
  wall.userData.holeBoxes=[];
  if(!wall.userData.airCuts?.length){
    if(!wall.userData.showBricks) wall.material.visible=true;
    return;
  }
  wall.userData.airCuts.forEach(cut=>{
    const ab=objects.find(o=>o.uuid===cut.abId);
    if(!ab||!ab.visible) return;
    const abBox=new THREE.Box3().setFromObject(ab);
    const wallBox=new THREE.Box3().setFromObject(wall);
    if(!wallBox.intersectsBox(abBox)) return;
    const inter=wallBox.clone().intersect(abBox);
    const sz=new THREE.Vector3(); inter.getSize(sz);
    cut.area=Math.max(sz.x,sz.z)*sz.y; cut.w=Math.max(sz.x,sz.z); cut.h=sz.y;
    renderVisualHole(ab, wall, inter);
  });
  if(wall.userData.showBricks){ clearBricks(wall); updateBricks(wall); }
}

function refreshAirList(){
  const el=document.getElementById('air-list'); if(!el) return;
  const abs=objects.filter(o=>o.userData.isAirBlock);
  if(!abs.length){el.innerHTML='<div style="color:var(--muted);font-size:10px">ยังไม่มี Air Block</div>';return;}
  el.innerHTML=abs.map((ab,i)=>{
    const cuts=objects.filter(w=>!w.userData.isAirBlock).filter(w=>w.userData.airCuts?.some(c=>c.abId===ab.uuid));
    return `<div class="ab-item${ab===sel?' on':''}" onclick="selectObj(objects.find(o=>o.uuid==='${ab.uuid}'))">
      <span>🌬</span><span class="ab-name">${ab.userData.name}</span>
      <span style="color:var(--muted);font-size:10px">${cuts.length} walls</span>
    </div>`;
  }).join('');
}

