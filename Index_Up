function copyObj(){
  if(!sel) return;
  const box=new THREE.Box3().setFromObject(sel),sz=new THREE.Vector3(); box.getSize(sz);
  clipboard={name:sel.userData.name,wallType:sel.userData.wallType,isAirBlock:sel.userData.isAirBlock,
    position:sel.position.toArray(),rotation:sel.rotation.toArray(),scale:sel.scale.toArray(),dims:[sz.x,sz.y,sz.z],
    drawPoints:sel.userData.drawPoints?JSON.parse(JSON.stringify(sel.userData.drawPoints)):null};
  toast('📋 Copied: '+sel.userData.name);
}
window.copyObj=copyObj;

function pasteObj(){
  if(!clipboard) return toast('คลิปบอร์ดว่าง');
  let mesh;
  if(clipboard.drawPoints){
    const shape=new THREE.Shape(); const pts=clipboard.drawPoints;
    shape.moveTo(pts[0].x,pts[0].y); pts.slice(1).forEach(p=>shape.lineTo(p.x,p.y));
    const geo=new THREE.ExtrudeGeometry(shape,{depth:clipboard.dims[1],bevelEnabled:false}); geo.rotateX(-Math.PI/2);
    mesh=new THREE.Mesh(geo,new THREE.MeshLambertMaterial());
  } else {
    mesh=new THREE.Mesh(new THREE.BoxGeometry(1,1,1),new THREE.MeshLambertMaterial());
    mesh.scale.fromArray(clipboard.scale);
  }
  mesh.position.fromArray(clipboard.position); mesh.position.x+=0.5; mesh.position.z+=0.5;
  mesh.rotation.fromArray(clipboard.rotation);
  if(clipboard.drawPoints) mesh.userData.drawPoints=JSON.parse(JSON.stringify(clipboard.drawPoints));
  addMesh(mesh,clipboard.name+' copy',clipboard.wallType);
}
window.pasteObj=pasteObj;

