function drawRbCanvas(p){
  const cvs=document.getElementById('rb-canvas'); if(!cvs) return;
  const ctx=cvs.getContext('2d'); const CW=cvs.width,CH=cvs.height;
  ctx.clearRect(0,0,CW,CH);
  const sc=Math.min((CW-30)/Math.max(p.w,p.h),(CH-16)/Math.max(p.w,p.h))*0.8;
  const ox=CW/2, oy=CH/2;
  const isRound=(p.type==='col_round');
  const isL=(p.type==='col_l'), isT=(p.type==='col_t');
  const sw=p.w*sc, sh=(isRound?p.w:p.h)*sc;
  ctx.fillStyle='#8fa3a840'; ctx.strokeStyle='#8fa3a8'; ctx.lineWidth=1.5;

  // Draw cross section
  if(isRound){
    const r=sw/2;
    ctx.beginPath(); ctx.arc(ox,oy,r,0,Math.PI*2); ctx.fill(); ctx.stroke();
    // stirrup
    ctx.strokeStyle='#fb923c'; ctx.lineWidth=1;
    ctx.beginPath(); ctx.arc(ox,oy,r-p.cover*sc,0,Math.PI*2); ctx.stroke();
    // bars
    for(let i=0;i<p.count;i++){
      const a=(i/p.count)*Math.PI*2;
      const br=r-p.cover*sc-(p.stirDia/2)*sc/10;
      ctx.fillStyle='#fb923c';
      ctx.beginPath(); ctx.arc(ox+br*Math.cos(a),oy+br*Math.sin(a),Math.max((p.dia/2)*sc/10,2.5),0,Math.PI*2); ctx.fill();
    }
  } else if(isL){
    ctx.fillRect(ox-sw/2,oy-sh/2,sw/2,sh);
    ctx.fillRect(ox-sw/2,oy+sh/2-sh/3,sw,sh/3);
    ctx.strokeRect(ox-sw/2,oy-sh/2,sw/2,sh);
    ctx.strokeRect(ox-sw/2,oy+sh/2-sh/3,sw,sh/3);
    drawSqBars(ctx,p,ox-sw/4,oy,sw/2,sh,sc);
  } else if(isT){
    ctx.fillRect(ox-sw/4,oy-sh/2,sw/2,sh);
    ctx.fillRect(ox-sw/2,oy-sh/2,sw,sh/3);
    ctx.strokeRect(ox-sw/4,oy-sh/2,sw/2,sh);
    ctx.strokeRect(ox-sw/2,oy-sh/2,sw,sh/3);
    drawSqBars(ctx,p,ox,oy-sh/4,sw/2,sh/2,sc);
  } else {
    ctx.fillRect(ox-sw/2,oy-sh/2,sw,sh);
    ctx.strokeRect(ox-sw/2,oy-sh/2,sw,sh);
    const cp=p.cover*sc; ctx.strokeStyle='#fb923c'; ctx.lineWidth=1;
    ctx.strokeRect(ox-sw/2+cp,oy-sh/2+cp,sw-cp*2,sh-cp*2);
    drawSqBars(ctx,p,ox,oy,sw,sh,sc);
  }
  ctx.fillStyle='#64748b'; ctx.font='9px JetBrains Mono';
  ctx.fillText(`${p.w}×${p.h}cm | DB${p.dia}×${p.count} | RB${p.stirDia}@${p.stirSp}cm`,3,CH-3);
}

function drawSqBars(ctx,p,ox,oy,sw,sh,sc){
  const cp=(p.cover+p.stirDia/10+p.dia/20)*sc;
  const x0=ox-sw/2+cp,x1=ox+sw/2-cp,y0=oy-sh/2+cp,y1=oy+sh/2-cp;
  const n=p.count, corners=[[x0,y0],[x1,y0],[x1,y1],[x0,y1]];
  const pts=[...corners]; if(n>4){const extra=n-4,pS=Math.floor(extra/4),rem=extra-pS*4;
    [[x0,y0,x1,y0,pS+(rem>0?1:0)],[x1,y0,x1,y1,pS+(rem>1?1:0)],[x1,y1,x0,y1,pS+(rem>2?1:0)],[x0,y1,x0,y0,pS]].forEach(([ax,ay,bx,by,c])=>{
      for(let i=1;i<=c;i++){const t=i/(c+1);pts.push([ax+t*(bx-ax),ay+t*(by-ay)]);}})}
  pts.slice(0,n).forEach(([bx,by])=>{ctx.fillStyle='#fb923c';ctx.beginPath();ctx.arc(bx,by,Math.max((p.dia/2)*sc/10,2.5),0,Math.PI*2);ctx.fill();});
}

