// ════ CUT MANAGEMENT ════
let controlMode='cursor'; // 'hand' or 'cursor'
function cutAirFromWall(airBlock,wall){
  if(!airBlock||!wall||airBlock.userData.isAirBlock===wall.userData.isAirBlock)return;
  const ab=airBlock.userData.isAirBlock?airBlock:wall;
  const w=wall.userData.isAirBlock?airBlock:wall;
  if(w.userData.isAirBlock)return toast('❌ Can only cut walls, not air blocks');
  const abBox=new THREE.Box3().setFromObject(ab);
  const wallBox=new THREE.Box3().setFromObject(w);
  const inter=wallBox.clone().intersect(abBox);
  const sz=new THREE.Vector3(); inter.getSize(sz);
  const cutArea=Math.max(sz.x,sz.z)*sz.y;
  if(cutArea<0.001)return toast('⚠️ Air block too small or not overlapping wall');
  if(!w.userData.airCuts)w.userData.airCuts=[];
  const existing=w.userData.airCuts.findIndex(c=>c.abId===ab.uuid);
  if(existing>=0){
    w.userData.airCuts.splice(existing,1);
    clearHoleMeshes(w);
    if(w.userData.splitMeshes){ w.userData.splitMeshes.forEach(m=>{scene.remove(m);m.geometry?.dispose();}); w.userData.splitMeshes=[]; }
    w.userData.holeBoxes=[];
    if(w.userData.airCuts.length===0){
      clearWallStencil(w);
      if(!w.userData.showBricks) w.material.visible=true;
    } else {
      w.userData.airCuts.forEach(c=>{
        const abObj=objects.find(o=>o.uuid===c.abId); if(!abObj) return;
        const abB=new THREE.Box3().setFromObject(abObj);
        const wB=new THREE.Box3().setFromObject(w);
        renderVisualHole(abObj,w,wB.clone().intersect(abB));
      });
    }
    if(w.userData.showBricks){clearBricks(w);updateBricks(w);}
    toast(`✂️ Removed cut from ${w.userData.name}`);
  } else {
    w.userData.airCuts.push({abId:ab.uuid,name:ab.userData.name,area:cutArea,w:Math.max(sz.x,sz.z),h:sz.y});
    if(!w.userData.holeMeshes)w.userData.holeMeshes=[];
    renderVisualHole(ab,w,inter);
    if(w.userData.showBricks){clearBricks(w);updateBricks(w);}
    toast(`✂️ Cut ${ab.userData.name} from ${w.userData.name}`);
  }
  refreshAirList();
}
