// Bond stress heatmap on wall surface
function applyBondStressColor(obj,on){
  if(!on){
    const mat=DB[obj.userData.wallType]; if(mat) obj.material.color.set(mat.color);
    obj.material.vertexColors=false; return;
  }
  // stress = max at edges/corners where rebar sits
  const geo=obj.geometry; if(!geo.attributes.position) return;
  const pos=geo.attributes.position, cols=new Float32Array(pos.count*3);
  for(let i=0;i<pos.count;i++){
    const lx=(pos.getX(i)+0.5),ly=(pos.getY(i)+0.5);
    const dx=Math.min(lx,1-lx)*2, dy=Math.min(ly,1-ly)*2;
    const stress=1-Math.min(dx,dy); // 0=center(safe), 1=edge(high stress)
    cols[i*3]=stress>0.5?1:stress*2; cols[i*3+1]=stress<0.5?1:(1-stress)*2; cols[i*3+2]=0.1*(1-stress);
  }
  geo.setAttribute('color',new THREE.BufferAttribute(cols,3));
  obj.material.vertexColors=true;
}

window.toggleBondStress=function(){
  bondStressOn=document.getElementById('chk-bond-stress').checked;
  objects.forEach(obj=>{if(!obj.userData.isAirBlock&&obj.userData.rebar)applyBondStressColor(obj,bondStressOn);});
};

