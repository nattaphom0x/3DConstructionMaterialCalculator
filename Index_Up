// ═══════════════════════════════════════════
// BRICK VISUALIZER
// ═══════════════════════════════════════════
function clearBricks(obj){
  if(!obj||!obj.userData.brickMesh) return;
  obj.remove(obj.userData.brickMesh);
  scene.remove(obj.userData.brickMesh);
  obj.userData.brickMesh.geometry?.dispose();
  obj.userData.brickMesh.material?.dispose();
  obj.userData.brickMesh=null;
}

function updateBricks(obj){
  if(!obj) return;
  clearBricks(obj);
  if(!obj.userData.showBricks){obj.material.visible=true;return;}
  if(obj.userData.isAirBlock){return;}
  obj.material.visible=false;
  const mat=DB[obj.userData.wallType];
  if(!mat||mat.calcType==='volume'){obj.material.visible=true;return;}

  obj.geometry.computeBoundingBox();
  const lbox=obj.geometry.boundingBox, lsz=new THREE.Vector3(); lbox.getSize(lsz);
  const W=lsz.x*Math.abs(obj.scale.x), H=lsz.y*Math.abs(obj.scale.y), D=lsz.z*Math.abs(obj.scale.z);
  const gap=(mat.gap||1.5)/100, uL=(mat.unitL||14)/100, uH=(mat.unitH||4)/100, uThick=(mat.unitW||6.5)/100;
  const cols=Math.ceil(W/(uL+gap)), rows=Math.ceil(H/(uH+gap)), layers=Math.max(1,Math.floor(D/(uThick+gap)));

  // Precompute world-space air cut boxes for this wall
  const airBoxes=[];
  if(obj.userData.airCuts?.length){
    obj.userData.airCuts.forEach(cut=>{
      const abObj=objects.find(o=>o.uuid===cut.abId);
      if(!abObj) return;
      airBoxes.push(new THREE.Box3().setFromObject(abObj));
    });
  }
  // Also check live air blocks by intersection even if not yet applied
  objects.filter(o=>o.userData.isAirBlock&&o.visible).forEach(ab=>{
    const abBox=new THREE.Box3().setFromObject(ab);
    const wallBox=new THREE.Box3().setFromObject(obj);
    if(wallBox.intersectsBox(abBox)&&!airBoxes.some(b=>b.equals(abBox))){
      // only skip if this ab is already applied as a cut
      // (don't auto-cut just because air block overlaps)
    }
  });

  const pos=[];
  const brickBox=new THREE.Box3();
  const brickHalf=new THREE.Vector3(uL/2-0.001, uH/2-0.001, uThick/2-0.001);

  for(let ly=0;ly<layers;ly++) for(let r=0;r<rows;r++) for(let c=0;c<cols;c++){
    const st=(r%2!==0)?uL/2:0;
    const bx=-W/2+uL/2+c*(uL+gap)-st;
    const by=-H/2+uH/2+r*(uH+gap);
    const bz=-D/2+uThick/2+ly*(uThick+gap);
    if(Math.abs(bx)>W/2+uL/2||by>H/2+uH/2) continue;

    // Convert brick local position → world position
    if(airBoxes.length>0){
      // local brick center in object-local space
      const localPos=new THREE.Vector3(
        bx/Math.abs(obj.scale.x),
        by/Math.abs(obj.scale.y),
        bz/Math.abs(obj.scale.z)
      );
      // to world space
      const worldPos=localPos.clone().applyMatrix4(obj.matrixWorld);
      // world-space brick bounding box
      brickBox.setFromCenterAndSize(worldPos, new THREE.Vector3(uL, uH, uThick));
      // Skip if this brick overlaps any air cut box (with small shrink tolerance)
      const brickBoxShrunk=brickBox.clone();
      brickBoxShrunk.expandByScalar(-0.01); // 1cm tolerance – brick must mostly be inside cut to skip
      let blocked=false;
      for(const ab of airBoxes){
        if(ab.containsBox(brickBoxShrunk)||ab.intersectsBox(brickBox)){
          // Check overlap volume – skip brick only if >50% is inside air box
          const overlap=brickBox.clone().intersect(ab);
          if(!overlap.isEmpty()){
            const ovSz=new THREE.Vector3(); overlap.getSize(ovSz);
            const bkSz=new THREE.Vector3(uL,uH,uThick);
            const ratio=(ovSz.x*ovSz.y*ovSz.z)/(bkSz.x*bkSz.y*bkSz.z);
            if(ratio>0.35){blocked=true;break;}
          }
        }
      }
      if(blocked) continue;
    }
    pos.push(bx/Math.abs(obj.scale.x),by/Math.abs(obj.scale.y),bz/Math.abs(obj.scale.z));
  }

  const cnt=pos.length/3; if(!cnt){obj.material.visible=true;return;}
  const ig=new THREE.InstancedMesh(
    new THREE.BoxGeometry(uL-.005,uH-.005,uThick-.003),
    new THREE.MeshLambertMaterial({color:mat.color}),cnt
  );
  // Apply same stencil test as wall so bricks also respect hole
  if(obj.material.stencilWrite){
    ig.material.stencilWrite=true;
    ig.material.stencilFunc=THREE.NotEqualStencilFunc;
    ig.material.stencilRef=1;
  }
  const dummy=new THREE.Object3D();
  for(let i=0;i<cnt;i++){
    dummy.position.set(pos[i*3],pos[i*3+1],pos[i*3+2]);
    dummy.updateMatrix();
    ig.setMatrixAt(i,dummy.matrix);
  }
  ig.instanceMatrix.needsUpdate=true; ig.castShadow=true; ig.receiveShadow=true;
  obj.add(ig); obj.userData.brickMesh=ig;
}

// ═══════════════════════════════════════════
// BOM CALCULATION  (มทอ. 101-64)
// ═══════════════════════════════════════════
function calcObjectData(obj){
  const box=new THREE.Box3().setFromObject(obj), sz=new THREE.Vector3(); box.getSize(sz);
  let area=Math.max(sz.x,sz.z)*sz.y;
  const vol=sz.x*sz.y*sz.z;

  // Recalculate cut areas from current AirBlock positions (not stale stored values)
  let cutArea=0;
  if(obj.userData.airCuts?.length){
    obj.userData.airCuts.forEach(cut=>{
      const ab=objects.find(o=>o.uuid===cut.abId);
      if(!ab) return;
      const abBox=new THREE.Box3().setFromObject(ab);
      const inter=box.clone().intersect(abBox);
      if(inter.isEmpty()) return;
      const isz=new THREE.Vector3(); inter.getSize(isz);
      cutArea+=Math.max(isz.x,isz.z)*isz.y;
      // Keep stored value in sync
      cut.area=Math.max(isz.x,isz.z)*isz.y;
      cut.w=Math.max(isz.x,isz.z); cut.h=isz.y;
    });
  }
  // Deduct legacy openings too
  if(obj.userData.openings?.length) cutArea+=obj.userData.openings.reduce((s,o)=>s+o.w*o.h,0);
  area=Math.max(0,area-cutArea);

  const mat=DB[obj.userData.wallType];
  let units3d=0,unitsStd=0,layers=1;
  if(mat&&mat.calcType==='unit'){
    const thick=Math.min(sz.x,sz.z), gap=(mat.gap||1.5)/100, uL=(mat.unitL||14)/100, uH=(mat.unitH||4)/100, uThick=(mat.unitW||6.5)/100;
    layers=Math.max(1,Math.floor(thick/(uThick+gap)));
    // Use area-based unit count (more accurate with holes)
    unitsStd=area*mat.unitsPerSqm*layers;
    units3d=unitsStd; // align display
  }
  return {sz,area,vol,units3d,unitsStd,layers,cutArea};
}

function bomHTML(key,data,label){
  if(data.area<0.001) return '';
  const mat=DB[key]; if(!mat) return '';
  const {area,vol,units3d,unitsStd,layers,cutArea}=data;
  const grossArea=area+(cutArea||0);
  let detail='',compare='';
  if(mat.calcType==='volume'){
    const tVol=vol*1.3, part=tVol/6;
    detail=`<table class="res"><tr><th>วัสดุ</th><th>ปริมาณ</th><th>หน่วย</th></tr>
      <tr><td>ดิน</td><td>${(part*3).toFixed(3)}</td><td>m³</td></tr>
      <tr><td>ทราย</td><td>${(part*2).toFixed(3)}</td><td>m³</td></tr>
      <tr><td>ปูน</td><td>${(part*1440/50).toFixed(1)}</td><td>ถุง</td></tr>
      <tr style="background:rgba(240,165,0,.08)"><td>รวม+เผื่อ30%</td><td>${tVol.toFixed(3)}</td><td>m³</td></tr></table>`;
  } else {
    compare=`<div class="compare-box"><div class="cx-title">⚖️ 3D vs Standard (มทอ.101-64)</div>
      <table class="res"><tr><th>วิธี</th><th>จำนวน</th><th>หมายเหตุ</th></tr>
      <tr><td>3D Sim</td><td style="color:var(--accent);font-family:var(--mono)">${Math.ceil(units3d)}</td><td style="color:var(--muted);font-size:10px">จากโมเดล</td></tr>
      <tr><td>Standard</td><td style="color:var(--green);font-family:var(--mono)">${Math.ceil(unitsStd)}</td><td style="color:var(--muted);font-size:10px">แนะนำสั่งซื้อ</td></tr>
      <tr><td>Layers</td><td>${layers}</td><td></td></tr></table></div>`;
    const mortar=area*mat.mortarPerSqm, sand=area*mat.sandPerSqm, plaster=(area*2)/2.5;
    detail=`<table class="res"><tr><th>วัสดุ</th><th>ปริมาณ</th><th>หน่วย</th></tr>
      <tr><td>${mat.name}</td><td style="font-weight:700">${Math.ceil(unitsStd)}</td><td>ชิ้น</td></tr>
      <tr><td>ปูนก่อ</td><td>${Math.ceil(mortar)}</td><td>ถุง</td></tr>
      <tr><td>ทราย</td><td>${sand.toFixed(3)}</td><td>m³</td></tr>
      <tr style="color:var(--muted)"><td>*ปูนฉาบ(2หน้า)</td><td>${Math.ceil(plaster)}</td><td>ถุง</td></tr></table>`;
  }
  const cutNote=cutArea>0.001?`<div style="color:#f87171;font-size:10px;margin-top:2px">✂️ หักช่องเปิด: −${cutArea.toFixed(3)} m² | พื้นที่รวมก่อนตัด: ${grossArea.toFixed(3)} m²</div>`:'';
  return `<div class="calc-block" style="border-color:${mat.color}">
    <h3 style="color:${mat.color}">${label||mat.name}</h3>
    <div class="sub">พื้นที่สุทธิ: ${area.toFixed(3)} m² | ปริมาตร: ${vol.toFixed(3)} m²${layers>1?` | ${layers} layers`:''}</div>
    ${cutNote}${compare}${detail}</div>`;
}

window.calcSingle=function(){
  if(!sel||sel.userData.isAirBlock) return;
  const d=calcObjectData(sel); d.objName=sel.userData.name;
